import { ComboBox, ScrollView } from "std-widgets.slint";

// Brutalist BMM palette: dark navy + BMM blue (#3b82f6), thick borders, hard
// (zero-blur) offset shadows, flat fills, bold type.
// Every colour is `in-out` so the Rust side can override it from the `[theme]`
// section of installer.toml — the whole installer is themeable from one TOML.
export global Pal {
    in-out property <color> bg: #0d1117;
    in-out property <color> panel: #161b22;
    in-out property <color> panel2: #1c2333;
    in-out property <color> border: #2f3b52;
    in-out property <color> accent: #3b82f6;
    in-out property <color> accent-dark: #1e3a8a;
    in-out property <color> accent-hover: #4b8ef8;
    in-out property <color> text: #e6edf3;
    in-out property <color> dim: #8b95a7;
    in-out property <color> danger: #e3342f;
    in-out property <color> shadow: #04060b;
}

export struct OptionRow {
    id: string,
    kind: string,
    label: string,
    description: string,
    choices: [string],
    bool-value: bool,
    string-value: string,
}

export struct CompRow {
    id: string,
    name: string,
    description: string,
    size: string,
    required: bool,
    checked: bool,
}

// A rendered markdown block. level: 0 paragraph · 1/2/3 heading · 4 bullet.
export struct MdBlock {
    text: string,
    level: int,
}

// An opt-in "launch now" checkbox on the Done page.
export struct LaunchRow {
    id: string,
    label: string,
    checked: bool,
}

// ── Brutalist button: thick border + hard shadow that "presses in" on click ──
component BrutalBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 42px;
    min-width: 104px;
    border-radius: 4px;
    border-width: 2px;
    border-color: !enabled ? Pal.border : (primary ? Pal.accent-dark : Pal.border);
    background: !enabled ? Pal.panel2
        : (primary ? (ta.has-hover ? Pal.accent-hover : Pal.accent)
                   : (ta.has-hover ? Pal.panel2 : Pal.panel));
    drop-shadow-offset-x: (ta.pressed && enabled) ? 0px : 4px;
    drop-shadow-offset-y: (ta.pressed && enabled) ? 0px : 4px;
    drop-shadow-blur: 0px;
    drop-shadow-color: primary ? #142a63 : Pal.shadow;
    animate drop-shadow-offset-x, drop-shadow-offset-y { duration: 60ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: root.text;
            color: !root.enabled ? #5b6577 : (root.primary ? white : Pal.text);
            font-size: 14px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ── Brutalist checkbox ──
component BrutalCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    // When true, the check never self-toggles: the parent owns `checked` and
    // updates it in response to `toggled`. Keeps a re-used checkbox in sync.
    in property <bool> controlled: false;
    callback toggled;
    height: 26px;
    opacity: root.enabled ? 1.0 : 0.55;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 2px;
            border-color: root.checked ? Pal.accent : Pal.border;
            background: root.checked ? Pal.accent : Pal.bg;
            Path {
                visible: root.checked;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 2 7 L 6 11 L 12 2";
                stroke: white;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: Pal.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            if !root.controlled { root.checked = !root.checked; }
            root.toggled();
        }
    }
}

// ── Window control button (minimize / maximize / close) ──
component WinBtn inherits Rectangle {
    in property <string> kind;   // "min" | "max" | "close"
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.kind == "close" ? Pal.danger : Pal.panel2) : transparent;
    Path {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: white;
        stroke-width: 1.6px;
        fill: transparent;
        commands: root.kind == "min" ? "M 1 6 L 11 6"
                : root.kind == "max" ? "M 1 1 L 11 1 L 11 11 L 1 11 Z"
                : "M 1 1 L 11 11 M 11 1 L 1 11";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Custom title bar (drag + window controls) ──
component TitleBar inherits Rectangle {
    in property <string> title;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    height: 42px;
    background: #0a0d13;
    Rectangle { y: parent.height - 2px; height: 2px; background: Pal.accent; } // bottom accent rule
    HorizontalLayout {
        drag := TouchArea {
            horizontal-stretch: 1;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-drag();
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 9px;
                alignment: start;
                Image {
                    source: @image-url("../../../BetterInstaller.png");
                    width: 18px; height: 18px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
                Text {
                    text: root.title;
                    color: white; font-size: 13px; font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
        WinBtn { kind: "min"; clicked => { root.minimize(); } }
        WinBtn { kind: "max"; clicked => { root.toggle-maximize(); } }
        WinBtn { kind: "close"; clicked => { root.close-window(); } }
    }
}

// ── Sidebar step indicator (brutalist square) ──
component StepItem inherits HorizontalLayout {
    in property <string> label;
    in property <int> index;
    in property <int> current;
    spacing: 11px;
    Rectangle {
        width: 14px; height: 14px; y: 3px;
        border-radius: 3px;
        border-width: 2px;
        border-color: index <= current ? Pal.accent : Pal.border;
        background: index < current ? Pal.accent : (index == current ? Pal.accent : transparent);
    }
    Text {
        text: label;
        font-size: 13px;
        color: index == current ? white : Pal.dim;
        font-weight: index == current ? 800 : 500;
    }
}

// ── Pages ──
component WelcomePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> app-version;
    in property <string> publisher;
    in property <string> loc-label: "Install location";
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <[CompRow]> components;
    in-out property <string> install-dir;
    callback component-toggled(string, bool);
    callback browse();
    spacing: 10px;
    Text { text: "Install " + app-name; font-size: 26px; font-weight: 900; color: white; }
    Text { text: "Version " + app-version + (publisher != "" ? "  ·  " + publisher : ""); font-size: 13px; color: Pal.dim; }

    // Signature / publisher trust badge.
    Rectangle {
        height: 34px;
        horizontal-stretch: 0;
        background: root.signed ? #122b1c : #2b1212;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.signed ? #2bbf6a : Pal.danger;
        HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 8px;
            alignment: start;
            // shield with check / cross
            Path {
                width: 16px; height: 16px;
                y: (parent.height - self.height) / 2;
                fill: root.signed ? #36d27e : #ff6b6b;
                commands: "M 8 0 L 15 3 L 15 8 C 15 12 12 15 8 16 C 4 15 1 12 1 8 L 1 3 Z";
            }
            Text {
                text: root.signature-status;
                color: root.signed ? #8be0ab : #ff9b9b;
                font-size: 12px; font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    Rectangle { height: 6px; }
    Text { text: loc-label; font-size: 12px; font-weight: 700; color: Pal.dim; }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            height: 46px;
            horizontal-stretch: 1;
            background: Pal.bg;
            border-radius: 4px;
            border-width: 2px;
            border-color: Pal.border;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                TextInput {
                    text <=> install-dir;
                    color: Pal.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }
        }
        BrutalBtn { text: "Browse…"; min-width: 96px; clicked => { root.browse(); } }
    }
    if root.components.length > 0 : Text {
        text: "Components"; font-size: 12px; font-weight: 700; color: Pal.dim;
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            padding-right: 8px;
            padding-bottom: 4px;
            for c in components : Rectangle {
                background: Pal.panel;
                border-radius: 7px;
                border-width: 2px;
                border-color: Pal.border;
                HorizontalLayout {
                    padding: 13px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        BrutalCheck {
                            checked: c.checked;
                            enabled: !c.required;
                            toggled => { component-toggled(c.id, self.checked); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: c.name; font-size: 13px; font-weight: 700; color: white; vertical-alignment: center; }
                            if c.required : Text { text: "required"; font-size: 10px; font-weight: 700; color: Pal.accent; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: c.size; font-size: 11px; color: Pal.dim; vertical-alignment: center; }
                        }
                        if c.description != "" : Text { text: c.description; font-size: 11px; color: Pal.dim; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

component SetupPage inherits VerticalLayout {
    in property <[OptionRow]> options;
    in property <string> title: "Configuration";
    in property <string> hint;
    in property <string> accept-label: "I accept";
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    spacing: 8px;
    Text { text: title; font-size: 22px; font-weight: 900; color: white; }
    Text { text: hint; font-size: 12px; color: Pal.dim; wrap: word-wrap; }
    Rectangle { height: 6px; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;
            padding-right: 8px;
            padding-bottom: 4px;
            // The card is a Rectangle with a SINGLE layout child so its height is
            // driven by the content (a sibling TouchArea breaks that propagation and
            // clips wrapped descriptions — that was the bug).
            for opt in options : Rectangle {
                background: Pal.panel;
                border-radius: 7px;
                border-width: 2px;
                border-color: Pal.border;
                drop-shadow-offset-x: 3px;
                drop-shadow-offset-y: 3px;
                drop-shadow-blur: 0px;
                drop-shadow-color: Pal.shadow;
                HorizontalLayout {
                    // Full-height accent stripe (in-layout so it spans the card).
                    Rectangle {
                        width: 5px;
                        background: Pal.accent;
                        border-top-left-radius: 5px;
                        border-bottom-left-radius: 5px;
                    }
                    HorizontalLayout {
                        padding: 15px;
                        spacing: 14px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            alignment: start;
                            Text { text: opt.label; font-size: 14px; font-weight: 800; color: white; }
                            if opt.description != "" : Text {
                                text: opt.description; font-size: 11px; color: Pal.dim; wrap: word-wrap;
                            }
                            if opt.kind == "license" : BrutalCheck {
                                text: accept-label;
                                checked: opt.bool-value;
                                toggled => { option-bool-changed(opt.id, self.checked); }
                            }
                        }
                        if opt.kind == "bool" : BrutalCheck {
                            checked: opt.bool-value;
                            toggled => { option-bool-changed(opt.id, self.checked); }
                        }
                        if opt.kind == "select" : ComboBox {
                            width: 150px;
                            height: 36px;
                            model: opt.choices;
                            current-value: opt.string-value;
                            selected(v) => { option-select-changed(opt.id, v); }
                        }
                    }
                }
            }
        }
    }
}

component ProgressPage inherits VerticalLayout {
    in property <float> progress;
    in property <string> progress-label;
    in property <string> installing-label: "Installing…";
    spacing: 14px;
    Rectangle { vertical-stretch: 1; }

    // Big live percentage.
    Text {
        text: round(root.progress * 100) + "%";
        font-size: 64px; font-weight: 900; color: Pal.accent;
        horizontal-alignment: center;
    }
    Text {
        text: installing-label;
        font-size: 18px; font-weight: 800; color: white;
        horizontal-alignment: center;
    }

    Rectangle { height: 4px; }

    // Brutalist progress bar with hard shadow + rounded accent fill.
    Rectangle {
        height: 26px;
        background: Pal.bg;
        border-radius: 5px;
        border-width: 2px;
        border-color: Pal.border;
        drop-shadow-offset-x: 4px;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 0px;
        drop-shadow-color: Pal.shadow;
        Rectangle {
            x: 3px; y: 3px;
            width: max(0px, (parent.width - 6px) * root.progress);
            height: parent.height - 6px;
            background: @linear-gradient(90deg, Pal.accent-dark 0%, Pal.accent 100%);
            border-radius: 3px;
            animate width { duration: 120ms; easing: ease-out; }
        }
    }

    // Live detail (current file / phase).
    Rectangle {
        height: 22px;
        clip: true;
        Text {
            text: root.progress-label;
            font-size: 11px; color: Pal.dim;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component CompletePage inherits VerticalLayout {
    in property <string> app-name;
    in property <bool> success;
    in property <string> result-title;     // e.g. "X was updated" / "X was uninstalled"
    in property <string> result-message;
    in property <[LaunchRow]> launch-items;
    callback launch-toggled(string, bool);
    spacing: 12px;
    Rectangle { vertical-stretch: 1; }
    Rectangle {
        width: 64px; height: 64px;
        x: (parent.width - self.width) / 2;
        border-radius: 6px; border-width: 3px;
        border-color: root.success ? #2bbf6a : Pal.danger;
        background: root.success ? #143b27 : #3b1414;
        Path {
            width: 32px; height: 32px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            stroke: root.success ? #36d27e : #ff6b6b; stroke-width: 3px; fill: transparent;
            commands: root.success ? "M 5 16 L 13 24 L 27 6" : "M 6 6 L 26 26 M 26 6 L 6 26";
        }
    }
    Text {
        text: root.result-title != "" ? root.result-title
            : (root.success ? app-name + " is installed" : "Installation failed");
        font-size: 21px; font-weight: 900; color: white; horizontal-alignment: center;
    }
    Text { text: result-message; font-size: 12px; color: Pal.dim; horizontal-alignment: center; wrap: word-wrap; }

    // Opt-in: pick what to start when closing the installer.
    if root.success && root.launch-items.length > 0 : Rectangle {
        horizontal-stretch: 0;
        x: (parent.width - self.width) / 2;
        width: min(parent.width, 380px);
        background: Pal.panel;
        border-radius: 6px; border-width: 2px; border-color: Pal.border;
        VerticalLayout {
            padding: 14px; spacing: 10px;
            Text { text: "Launch now"; font-size: 12px; font-weight: 700; color: Pal.dim; }
            for it in root.launch-items : BrutalCheck {
                text: it.label;
                checked: it.checked;
                toggled => { root.launch-toggled(it.id, self.checked); }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component LegalPage inherits VerticalLayout {
    in property <string> doc-title;
    in property <[MdBlock]> blocks;
    in property <int> index;
    in property <int> count;
    in property <string> accept-text;
    in-out property <bool> accepted;
    callback accept-toggled(bool);
    spacing: 10px;
    HorizontalLayout {
        Text { text: doc-title; font-size: 22px; font-weight: 900; color: white; horizontal-stretch: 1; }
        Text { text: "Doc " + (index + 1) + " / " + count; font-size: 12px; font-weight: 700; color: Pal.dim; vertical-alignment: center; }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Pal.panel;
        border-radius: 6px;
        border-width: 2px;
        border-color: Pal.border;
        ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 5px;
                for b in blocks : Text {
                    text: b.level == 4 ? "•  " + b.text : b.text;
                    font-size: b.level == 1 ? 18px : (b.level == 2 ? 15px : (b.level == 3 ? 13px : 12px));
                    font-weight: (b.level >= 1 && b.level <= 3) ? 800 : 400;
                    color: (b.level >= 1 && b.level <= 3) ? white : Pal.text;
                    wrap: word-wrap;
                }
            }
        }
    }
    BrutalCheck {
        text: root.accept-text;
        checked: root.accepted;
        controlled: true;
        // `checked` still reflects the old value (no self-toggle), so send its inverse.
        toggled => { root.accept-toggled(!self.checked); }
    }
}

component MaintenancePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    callback repair();
    callback update();
    callback uninstall();
    // "" = choose · "repair"/"update"/"uninstall" = confirmation pending (cancelable).
    property <string> pending: "";
    spacing: 12px;
    Text { text: app-name; font-size: 26px; font-weight: 900; color: white; }
    Text {
        text: "Installed" + (root.installed-version != "" ? "  ·  v" + root.installed-version : "");
        font-size: 13px; color: Pal.dim;
    }
    Text { text: location; font-size: 12px; color: Pal.text; wrap: word-wrap; }

    // Update-available banner.
    if root.update-available : Rectangle {
        height: 34px;
        background: #122b1c;
        border-radius: 4px; border-width: 2px; border-color: #2bbf6a;
        HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 8px; alignment: start;
            Text {
                text: "Update available: v" + root.installed-version + "  →  v" + root.new-version;
                color: #8be0ab; font-size: 12px; font-weight: 700; vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 10px; }

    if root.pending == "" : VerticalLayout {
        spacing: 12px;
        Text { text: "What would you like to do?"; font-size: 13px; font-weight: 700; color: Pal.dim; }
        HorizontalLayout {
            spacing: 12px;
            // Update only appears when a newer version is bundled.
            if root.update-available : BrutalBtn { text: "Update"; primary: true; clicked => { root.pending = "update"; } }
            BrutalBtn { text: "Repair"; primary: !root.update-available; clicked => { root.pending = "repair"; } }
            BrutalBtn { text: "Uninstall"; clicked => { root.pending = "uninstall"; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if root.pending != "" : VerticalLayout {
        spacing: 14px;
        Text {
            text: root.pending == "uninstall"
                ? "Uninstall " + root.app-name + "?  This removes all installed files."
                : (root.pending == "update"
                    ? "Update " + root.app-name + " to v" + root.new-version + "?"
                    : "Repair " + root.app-name + "?  Files will be re-verified and restored.");
            font-size: 14px; font-weight: 700; color: Pal.text; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 12px;
            BrutalBtn {
                text: root.pending == "uninstall" ? "Yes, uninstall"
                    : (root.pending == "update" ? "Yes, update" : "Yes, repair");
                primary: true;
                clicked => {
                    if (root.pending == "uninstall") { root.uninstall(); }
                    else if (root.pending == "update") { root.update(); }
                    else { root.repair(); }
                    root.pending = "";
                }
            }
            BrutalBtn { text: "Cancel"; clicked => { root.pending = ""; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// ── Main window (frameless: OS decorations disabled from Rust) ──
export component MainWindow inherits Window {
    title: "BetterInstaller";
    icon: @image-url("../../../BetterInstaller.png");
    preferred-width: 800px;
    preferred-height: 560px;
    min-width: 720px;
    min-height: 520px;
    background: Pal.bg;
    no-frame: true;

    in property <int> page: 0;
    in property <bool> maintenance: false;
    in property <string> maintenance-verb: "Maintenance";
    in property <string> install-location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    in property <string> app-name: "Application";
    in property <image> app-logo;
    in property <string> app-version: "1.0.0";
    in property <string> publisher: "";
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <[LaunchRow]> launch-items;
    in-out property <string> install-dir;
    in property <[OptionRow]> options;
    in property <[CompRow]> components;
    in property <string> legal-title;
    in property <[MdBlock]> legal-blocks;
    in property <string> legal-accept-text: "I have read and accept this document.";
    in property <int> legal-index: 0;
    in property <int> legal-count: 0;
    in-out property <bool> legal-accepted: false;
    in property <float> progress: 0;
    in property <string> progress-label;
    in property <bool> can-proceed: true;
    in property <bool> success: true;
    in property <string> result-message;
    in property <string> result-title;
    in property <color> accent: #3b82f6;

    in property <string> t-next: "Next";
    in property <string> t-back: "Back";
    in property <string> t-install: "Install";
    in property <string> t-finish: "Finish";
    in property <string> t-config-title: "Configuration";
    in property <string> t-config-hint: "These choices are applied on first launch — no setup needed inside the app.";
    in property <string> t-install-loc: "Install location";
    in property <string> t-installing: "Installing…";
    in property <string> t-accept: "I accept";

    callback go-back();
    callback go-next();
    callback install();
    callback finish();
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    callback component-toggled(string, bool);
    callback legal-accept-toggled(bool);
    callback browse-location();
    callback launch-toggled(string, bool);
    callback repair();
    callback update-app();
    callback uninstall-app();
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    VerticalLayout {
        TitleBar {
            title: "BetterInstaller  —  " + root.app-name;
            start-drag => { root.start-drag(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;          // fill the window below the title bar
            // Sidebar
            Rectangle {
                width: 216px;
                background: #11151d;
                Rectangle { x: parent.width - 2px; width: 2px; background: Pal.border; }
                VerticalLayout {
                    padding: 24px;
                    spacing: 6px;
                    // Branding header: the app's logo (if provided) + the app name.
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.app-logo.width > 0 : Image {
                            source: root.app-logo;
                            width: 28px; height: 28px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }
                        if root.app-logo.width <= 0 : Image {
                            source: @image-url("../../../BetterInstaller.png");
                            width: 28px; height: 28px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.app-name;
                            font-size: 16px; font-weight: 900; color: white;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }   // push the steps toward the bottom
                    VerticalLayout {
                        spacing: 16px;
                        StepItem { label: "Welcome"; index: 0; current: root.page; }
                        // Terms + Setup are only part of a fresh install.
                        if !root.maintenance && root.legal-count > 0 : StepItem { label: "Terms"; index: 1; current: root.page; }
                        if !root.maintenance : StepItem { label: "Setup"; index: 2; current: root.page; }
                        // The action step: "Install" for a fresh install, else the
                        // maintenance verb (Repair / Update / Uninstall).
                        StepItem { label: root.maintenance ? root.maintenance-verb : "Install"; index: 3; current: root.page; }
                        StepItem { label: "Done"; index: 4; current: root.page; }
                    }
                }
            }
            // Content
            Rectangle {
                background: Pal.bg;
                VerticalLayout {
                    padding: 28px;
                    spacing: 20px;          // breathing room between content and the button bar
                    Rectangle {
                        vertical-stretch: 1;
                        if root.page == 0 && root.maintenance : MaintenancePage {
                            app-name: root.app-name;
                            location: root.install-location;
                            installed-version: root.installed-version;
                            new-version: root.app-version;
                            update-available: root.update-available;
                            repair => { root.repair(); }
                            update => { root.update-app(); }
                            uninstall => { root.uninstall-app(); }
                        }
                        if root.page == 0 && !root.maintenance : WelcomePage {
                            app-name: root.app-name;
                            app-version: root.app-version;
                            publisher: root.publisher;
                            loc-label: root.t-install-loc;
                            signed: root.signed;
                            signature-status: root.signature-status;
                            components: root.components;
                            install-dir <=> root.install-dir;
                            component-toggled(id, v) => { root.component-toggled(id, v); }
                            browse => { root.browse-location(); }
                        }
                        if root.page == 1 : LegalPage {
                            doc-title: root.legal-title;
                            blocks: root.legal-blocks;
                            index: root.legal-index;
                            count: root.legal-count;
                            accept-text: root.legal-accept-text;
                            accepted: root.legal-accepted;
                            accept-toggled(v) => { root.legal-accept-toggled(v); }
                        }
                        if root.page == 2 : SetupPage {
                            options: root.options;
                            title: root.t-config-title;
                            hint: root.t-config-hint;
                            accept-label: root.t-accept;
                            option-bool-changed(id, v) => { root.option-bool-changed(id, v); }
                            option-select-changed(id, v) => { root.option-select-changed(id, v); }
                        }
                        if root.page == 3 : ProgressPage {
                            progress: root.progress;
                            progress-label: root.progress-label;
                            installing-label: root.maintenance ? root.maintenance-verb + "…" : root.t-installing;
                        }
                        if root.page == 4 : CompletePage {
                            app-name: root.app-name;
                            success: root.success;
                            result-title: root.result-title;
                            result-message: root.result-message;
                            launch-items: root.launch-items;
                            launch-toggled(id, v) => { root.launch-toggled(id, v); }
                        }
                    }
                    HorizontalLayout {
                        height: 46px;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        if root.page == 1 || root.page == 2 : BrutalBtn {
                            text: root.t-back;
                            clicked => { root.go-back(); }
                        }
                        if (root.page == 0 && !root.maintenance) || root.page == 1 : BrutalBtn {
                            text: root.t-next; primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.go-next(); }
                        }
                        if root.page == 2 : BrutalBtn {
                            text: root.t-install; primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.install(); }
                        }
                        if root.page == 4 : BrutalBtn {
                            text: root.t-finish; primary: true;
                            clicked => { root.finish(); }
                        }
                    }
                }
            }
        }
    }
}
