import { ComboBox, ScrollView } from "std-widgets.slint";

// Brutalist BMM palette: dark navy + BMM blue (#3b82f6), thick borders, hard
// (zero-blur) offset shadows, flat fills, bold type.
// Every colour is `in-out` so the Rust side can override it from the `[theme]`
// section of installer.toml — the whole installer is themeable from one TOML.
export global Pal {
    in-out property <color> bg: #0d1117;
    in-out property <color> panel: #161b22;
    in-out property <color> panel2: #1c2333;
    in-out property <color> border: #2f3b52;
    in-out property <color> accent: #3b82f6;
    in-out property <color> accent-dark: #1e3a8a;
    in-out property <color> accent-hover: #4b8ef8;
    in-out property <color> text: #e6edf3;
    in-out property <color> dim: #8b95a7;
    in-out property <color> danger: #e3342f;
    in-out property <color> shadow: #04060b;
}

// Every string on screen that is not product data comes through here.
//
// `tr(key, rev)` is answered by Rust from the runtime catalogues (bpkg-core/src/i18n.rs).
// `rev` is not used by the lookup: passing it makes every binding that shows a string
// depend on it, so bumping it after a language switch re-evaluates all of them at once.
// That is what lets the language change mid-flow without rebuilding the window.
export global I18n {
    in property <int> rev: 0;
    // Right-to-left language: text is right-aligned. The layout itself is NOT mirrored
    // (Slint lays out left to right); see the note at the entry point in main.rs.
    in property <bool> rtl: false;
    pure callback tr(string, int) -> string;
}

// One tile of a `swatch` option: a value, a name, and the four colors the little
// fake window in the tile is painted with.
export struct SwatchRow {
    value: string,
    label: string,
    bg: color,
    surface: color,
    accent: color,
    ink: color,
}

export struct OptionRow {
    id: string,
    kind: string,
    label: string,
    description: string,
    // For `select`: the values (written to the handoff) and, index for index, what the
    // user reads. The dropdown shows the labels and reports an index, so a translated
    // label can never leak into the handoff as a value.
    choices: [string],
    choice-labels: [string],
    choice-index: int,
    bool-value: bool,
    string-value: string,
    previews: [SwatchRow],
    // "Default: On", already translated. Shown on every row so the default is visible
    // without having to remember it or reset the page.
    default-label: string,
    is-default: bool,
    sends-data: bool,
    // Non-empty on the first row of a group: the heading drawn above that row.
    header: string,
    header-description: string,
}

export struct CompRow {
    id: string,
    name: string,
    description: string,
    size: string,
    required: bool,
    checked: bool,
}

// A rendered markdown block. level: 0 paragraph · 1/2/3 heading · 4 bullet · 5 link.
//
// `link` is the URL a level-5 row opens. It is a separate field rather than a convention
// on `text` so the view never has to guess whether a line happens to look like an address.
export struct MdBlock {
    text: string,
    level: int,
    link: string,
}

// An opt-in "launch now" checkbox on the Done page.
export struct LaunchRow {
    id: string,
    label: string,
    checked: bool,
}

// ── Brutalist button: thick border + hard shadow that "presses in" on click ──
component BrutalBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 42px;
    min-width: 104px;
    border-radius: 4px;
    border-width: 2px;
    border-color: !enabled ? Pal.border : (primary ? Pal.accent-dark : Pal.border);
    background: !enabled ? Pal.panel2
        : (primary ? (ta.has-hover ? Pal.accent-hover : Pal.accent)
                   : (ta.has-hover ? Pal.panel2 : Pal.panel));
    drop-shadow-offset-x: (ta.pressed && enabled) ? 0px : 4px;
    drop-shadow-offset-y: (ta.pressed && enabled) ? 0px : 4px;
    drop-shadow-blur: 0px;
    drop-shadow-color: primary ? #142a63 : Pal.shadow;
    animate drop-shadow-offset-x, drop-shadow-offset-y { duration: 60ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        // The label had no horizontal padding, so anything longer than the 104px floor
        // ran to the border and read as cramped — "Keep the current one" touched both
        // edges. The layout's preferred width is text + padding, so the button now grows
        // with its label and min-width stays what it always was: a floor for short ones.
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: !root.enabled ? #5b6577 : (root.primary ? white : Pal.text);
            font-size: 14px;
            font-weight: 800;
            vertical-alignment: center;
            // One line, never clipped: a wrapped label inside a 42px button would be cut
            // in half rather than wrap visibly.
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ── Brutalist checkbox ──
component BrutalCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    // When true, the check never self-toggles: the parent owns `checked` and
    // updates it in response to `toggled`. Keeps a re-used checkbox in sync.
    in property <bool> controlled: false;
    callback toggled;
    height: 26px;
    opacity: root.enabled ? 1.0 : 0.55;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 2px;
            border-color: root.checked ? Pal.accent : Pal.border;
            background: root.checked ? Pal.accent : Pal.bg;
            Path {
                visible: root.checked;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 2 7 L 6 11 L 12 2";
                stroke: white;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: Pal.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            // Elided, not clipped: a French label is often a third longer than the
            // English one it replaced, and a fixed 26px row cannot grow to wrap.
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            if !root.controlled { root.checked = !root.checked; }
            root.toggled();
        }
    }
}

// ── Window control button (minimize / maximize / close) ──
component WinBtn inherits Rectangle {
    in property <string> kind;   // "min" | "max" | "close"
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.kind == "close" ? Pal.danger : Pal.panel2) : transparent;
    Path {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: white;
        stroke-width: 1.6px;
        fill: transparent;
        commands: root.kind == "min" ? "M 1 6 L 11 6"
                : root.kind == "max" ? "M 1 1 L 11 1 L 11 11 L 1 11 Z"
                : "M 1 1 L 11 11 M 11 1 L 1 11";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Custom title bar (drag + window controls) ──
component TitleBar inherits Rectangle {
    in property <string> title;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    height: 42px;
    background: #0a0d13;
    Rectangle { y: parent.height - 2px; height: 2px; background: Pal.accent; } // bottom accent rule
    HorizontalLayout {
        drag := TouchArea {
            horizontal-stretch: 1;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-drag();
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 9px;
                alignment: start;
                Image {
                    source: @image-url("../../../BetterInstaller.png");
                    width: 18px; height: 18px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
                Text {
                    text: root.title;
                    color: white; font-size: 13px; font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
        WinBtn { kind: "min"; clicked => { root.minimize(); } }
        WinBtn { kind: "max"; clicked => { root.toggle-maximize(); } }
        WinBtn { kind: "close"; clicked => { root.close-window(); } }
    }
}

// ── Sidebar step indicator (brutalist square) ──
component StepItem inherits HorizontalLayout {
    in property <string> label;
    in property <int> index;
    in property <int> current;
    spacing: 11px;
    Rectangle {
        width: 14px; height: 14px; y: 3px;
        border-radius: 3px;
        border-width: 2px;
        border-color: index <= current ? Pal.accent : Pal.border;
        background: index < current ? Pal.accent : (index == current ? Pal.accent : transparent);
    }
    Text {
        text: label;
        font-size: 13px;
        color: index == current ? white : Pal.dim;
        font-weight: index == current ? 800 : 500;
    }
}

// ── Pages ──
component WelcomePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> app-version;
    in property <string> publisher;
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <[CompRow]> components;
    in-out property <string> install-dir;
    callback component-toggled(string, bool);
    callback browse();
    spacing: 10px;
    Text { text: I18n.tr("welcome.title", I18n.rev); font-size: 26px; font-weight: 900; color: white; wrap: word-wrap; }
    Text { text: I18n.tr("welcome.version", I18n.rev) + (publisher != "" ? "  ·  " + publisher : ""); font-size: 13px; color: Pal.dim; }

    // Signature / publisher trust badge.
    Rectangle {
        height: 34px;
        horizontal-stretch: 0;
        background: root.signed ? #122b1c : #2b1212;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.signed ? #2bbf6a : Pal.danger;
        HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 8px;
            alignment: start;
            // shield with check / cross
            Path {
                width: 16px; height: 16px;
                y: (parent.height - self.height) / 2;
                fill: root.signed ? #36d27e : #ff6b6b;
                commands: "M 8 0 L 15 3 L 15 8 C 15 12 12 15 8 16 C 4 15 1 12 1 8 L 1 3 Z";
            }
            Text {
                text: root.signature-status;
                color: root.signed ? #8be0ab : #ff9b9b;
                font-size: 12px; font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    Rectangle { height: 6px; }
    Text { text: I18n.tr("welcome.location", I18n.rev); font-size: 12px; font-weight: 700; color: Pal.dim; }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            height: 46px;
            horizontal-stretch: 1;
            background: Pal.bg;
            border-radius: 4px;
            border-width: 2px;
            border-color: Pal.border;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                TextInput {
                    text <=> install-dir;
                    color: Pal.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }
        }
        BrutalBtn { text: I18n.tr("ui.browse", I18n.rev); min-width: 96px; clicked => { root.browse(); } }
    }
    if root.components.length > 0 : Text {
        text: I18n.tr("welcome.components", I18n.rev); font-size: 12px; font-weight: 700; color: Pal.dim;
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            padding-right: 8px;
            padding-bottom: 4px;
            for c in components : Rectangle {
                background: Pal.panel;
                border-radius: 7px;
                border-width: 2px;
                border-color: Pal.border;
                // vertical-stretch: 0, and this is the whole reason the rows were huge.
                // A Rectangle stretches by default, so a VerticalLayout handed the three
                // component cards ALL the leftover height and each one grew to a third of
                // the page — two lines of text floating in 120px of panel. Now each row is
                // as tall as its own content and the spacer below soaks up the rest.
                vertical-stretch: 0;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        BrutalCheck {
                            checked: c.checked;
                            enabled: !c.required;
                            toggled => { component-toggled(c.id, self.checked); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: c.name; font-size: 13px; font-weight: 700; color: white; vertical-alignment: center; }
                            if c.required : Text { text: I18n.tr("welcome.required", I18n.rev); font-size: 10px; font-weight: 700; color: Pal.accent; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: c.size; font-size: 11px; color: Pal.dim; vertical-alignment: center; }
                        }
                        if c.description != "" : Text { text: c.description; font-size: 11px; color: Pal.dim; wrap: word-wrap; }
                    }
                }
            }
            // Takes the leftover height so the rows above don't have to.
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// ── A swatch tile: a miniature app window painted in the choice's own colors ──
//
// Deliberately a caricature — a title bar, a sidebar, a card, a button — because
// the point is to recognise a look at a glance, not to preview a real screen. It
// is drawn from four colors and nothing else, so any project can declare one
// without shipping a screenshot per choice.
component SwatchTile inherits Rectangle {
    in property <SwatchRow> data;
    in property <bool> selected;
    callback picked();
    width: 146px;
    height: 118px;

    // The frame: the accent border is what reads as "this one is chosen".
    Rectangle {
        y: 0;
        width: parent.width;
        height: 90px;
        background: root.data.bg;
        border-radius: 7px;
        border-width: selected ? 3px : 2px;
        border-color: selected ? Pal.accent : Pal.border;
        clip: true;

        // Title bar + its three window buttons.
        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 15px;
            background: root.data.surface;
        }
        for d[i] in [0, 1, 2] : Rectangle {
            x: parent.width - 10px - (i * 9px);
            y: 5px;
            width: 5px; height: 5px;
            border-radius: 2.5px;
            background: root.data.ink;
            opacity: 0.35;
        }

        // Sidebar with three nav lines.
        Rectangle {
            x: 0; y: 15px;
            width: 36px; height: parent.height - 15px;
            background: root.data.surface;
        }
        for n[i] in [0, 1, 2] : Rectangle {
            x: 7px;
            y: 26px + (i * 11px);
            width: 22px; height: 4px;
            border-radius: 2px;
            background: i == 0 ? root.data.accent : root.data.ink;
            opacity: i == 0 ? 1.0 : 0.3;
        }

        // Content card: a heading, two lines of text, and a primary button.
        Rectangle {
            x: 44px; y: 23px;
            width: parent.width - 54px; height: parent.height - 33px;
            background: root.data.surface;
            border-radius: 4px;
            Rectangle {
                x: 7px; y: 7px; width: 40px; height: 5px;
                border-radius: 2px; background: root.data.ink;
            }
            Rectangle {
                x: 7px; y: 18px; width: parent.width - 20px; height: 3px;
                border-radius: 1.5px; background: root.data.ink; opacity: 0.32;
            }
            Rectangle {
                x: 7px; y: 25px; width: (parent.width - 20px) * 0.6; height: 3px;
                border-radius: 1.5px; background: root.data.ink; opacity: 0.32;
            }
            Rectangle {
                x: 7px; y: parent.height - 17px;
                width: 34px; height: 11px;
                border-radius: 3px; background: root.data.accent;
            }
        }
    }

    Text {
        y: 95px;
        width: parent.width;
        text: root.data.label;
        font-size: 11px;
        font-weight: selected ? 800 : 500;
        color: selected ? white : Pal.dim;
        horizontal-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.picked(); }
    }
    opacity: ta.has-hover && !selected ? 0.85 : 1.0;
    animate opacity { duration: 90ms; }
}

// A wrapping grid of tiles, three per root.data. Slint has no flow layout, so the
// position is arithmetic — and the container states its own height, or a
// ScrollView around it would measure zero and show nothing.
component SwatchGrid inherits Rectangle {
    in property <[SwatchRow]> rows;
    in property <string> value;
    callback picked(string);
    // The tiles are positioned absolutely, so this Rectangle has no PREFERRED height of
    // its own — and a preferred height is exactly what a ScrollView sizes its viewport
    // from. Setting `height` alone made the grid the right size and left the ScrollView
    // believing there was nothing to scroll: with twelve themes the last rows rendered,
    // were clipped by the dialog, and no wheel or drag would reach them.
    //
    // So the needed height is PUBLISHED, and every ScrollView holding one of these binds
    // its viewport-height to it rather than guessing.
    // FOUR per row where there is room for four. The Configuration page's content column is
    // ~720px wide, so a third of the grid was empty at three and twelve themes still needed
    // four rows; four columns is 614px, which fits there and brings them down to three rows.
    //
    // An INPUT, because there is a second place this grid is shown and it is narrower. The
    // final dialog is 516px of content, where a fourth column lands at x = 468px — outside
    // the viewport. Nothing said so: the layout is arithmetic, the width never drove it, and
    // the dialog's hand-tuned `width: 458px` (which is exactly three columns) was simply
    // ignored. With thirteen themes that is three tiles nobody could see or reach.
    in property <int> cols: 4;
    // Derived, not asserted beside `cols`. It used to be the constant 614px sitting next to a
    // hardcoded 4 — true together, and silently wrong the moment either moved.
    out property <length> content-width: cols * 156px - 10px;
    out property <length> content-height: (floor((max(rows.length, 1) - 1) / cols) + 1) * 130px;
    // min-height, not height: a LAYOUT sizes its children from min/preferred and ignores
    // an explicit height, so the copy on the Configuration page would be allotted no room
    // and overlap whatever follows it. Slint refuses both at once, and min-height is the
    // one that satisfies the layout AND still makes every row render inside a ScrollView.
    min-height: content-height;
    for sw[i] in rows : SwatchTile {
        x: (i - floor(i / cols) * cols) * 156px;
        y: floor(i / cols) * 130px;
        data: sw;
        selected: sw.value == root.value;
        picked => { root.picked(sw.value); }
    }
}

// A small pill next to an option's label ("Sends data", "Changed").
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Pal.accent;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.tint;
    background: transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

component SetupPage inherits VerticalLayout {
    in property <[OptionRow]> options;
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    callback option-choice-picked(string, int);
    callback reset();
    spacing: 8px;
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: I18n.tr("setup.title", I18n.rev);
            font-size: 22px; font-weight: 900; color: white;
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: I18n.rtl ? right : left;
        }
        // Undo every change on this page in one click. Legal acceptance is not an option
        // here and is never touched by it.
        BrutalBtn {
            height: 34px;
            min-width: 0px;
            text: I18n.tr("setup.reset", I18n.rev);
            clicked => { root.reset(); }
        }
    }
    Text {
        text: I18n.tr("setup.hint", I18n.rev);
        font-size: 12px; color: Pal.dim; wrap: word-wrap;
        horizontal-alignment: I18n.rtl ? right : left;
    }
    Rectangle { height: 4px; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 10px;
            padding-right: 12px;
            padding-bottom: 6px;
            for opt in options : VerticalLayout {
                spacing: 8px;
                // Group heading, drawn above the first option of each group. Part of the
                // row rather than a row of its own so the model stays one entry per option
                // and every callback keeps addressing options by id.
                if opt.header != "" : VerticalLayout {
                    padding-top: 10px;
                    spacing: 2px;
                    Text {
                        text: opt.header;
                        font-size: 15px; font-weight: 900; color: white;
                        wrap: word-wrap;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                    if opt.header-description != "" : Text {
                        text: opt.header-description;
                        font-size: 11px; color: Pal.dim; wrap: word-wrap;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                    Rectangle { height: 2px; background: Pal.border; }
                }
                // The card is a Rectangle with a SINGLE layout child so its height is
                // driven by the content (a sibling TouchArea breaks that propagation and
                // clips wrapped descriptions — that was the bug).
                Rectangle {
                    background: Pal.panel;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: opt.is-default ? Pal.border : Pal.accent-dark;
                    drop-shadow-offset-x: 3px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-blur: 0px;
                    drop-shadow-color: Pal.shadow;
                    HorizontalLayout {
                        // Full-height accent stripe (in-layout so it spans the card).
                        Rectangle {
                            width: 5px;
                            background: opt.sends-data ? #d98a1c : Pal.accent;
                            border-top-left-radius: 5px;
                            border-bottom-left-radius: 5px;
                        }
                        HorizontalLayout {
                            padding: 13px;
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                alignment: start;
                                HorizontalLayout {
                                    spacing: 8px;
                                    // Wraps: a label is never cut at the card's edge, in any
                                    // language.
                                    Text {
                                        text: opt.label;
                                        font-size: 14px; font-weight: 800; color: white;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: I18n.rtl ? right : left;
                                    }
                                    if opt.sends-data : Tag {
                                        text: I18n.tr("setup.sends_data", I18n.rev);
                                        tint: #f0a53a;
                                    }
                                }
                                if opt.description != "" : Text {
                                    text: opt.description; font-size: 11px; color: Pal.dim; wrap: word-wrap;
                                    horizontal-alignment: I18n.rtl ? right : left;
                                }
                                // The default, always on screen, and whether this row has
                                // moved away from it.
                                HorizontalLayout {
                                    spacing: 8px;
                                    if opt.default-label != "" : Text {
                                        text: opt.default-label;
                                        font-size: 10px; font-weight: 700; color: Pal.dim;
                                        vertical-alignment: center;
                                    }
                                    if !opt.is-default : Tag { text: I18n.tr("setup.changed", I18n.rev); }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // A swatch is too wide to sit beside its label, so it
                                // goes under it and spans the card.
                                if opt.kind == "swatch" : SwatchGrid {
                                    rows: opt.previews;
                                    value: opt.string-value;
                                    picked(v) => { option-select-changed(opt.id, v); }
                                }
                            }
                            if opt.kind == "bool" : VerticalLayout {
                                alignment: center;
                                BrutalCheck {
                                    width: 22px;
                                    checked: opt.bool-value;
                                    toggled => { option-bool-changed(opt.id, self.checked); }
                                }
                            }
                            // Shows labels, reports an index: the value written is always
                            // one of `choices`, whatever language the label is in.
                            if opt.kind == "select" : VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    min-width: 200px;
                                    height: 36px;
                                    model: opt.choice-labels;
                                    current-index: opt.choice-index;
                                    selected => { option-choice-picked(opt.id, self.current-index); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component ProgressPage inherits VerticalLayout {
    in property <float> progress;
    in property <string> progress-label;
    in property <string> installing-label: "Installing…";
    spacing: 14px;
    Rectangle { vertical-stretch: 1; }

    // Big live percentage.
    Text {
        text: round(root.progress * 100) + "%";
        font-size: 64px; font-weight: 900; color: Pal.accent;
        horizontal-alignment: center;
    }
    Text {
        text: installing-label;
        font-size: 18px; font-weight: 800; color: white;
        horizontal-alignment: center;
    }

    Rectangle { height: 4px; }

    // Brutalist progress bar with hard shadow + rounded accent fill.
    Rectangle {
        height: 26px;
        background: Pal.bg;
        border-radius: 5px;
        border-width: 2px;
        border-color: Pal.border;
        drop-shadow-offset-x: 4px;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 0px;
        drop-shadow-color: Pal.shadow;
        Rectangle {
            x: 3px; y: 3px;
            width: max(0px, (parent.width - 6px) * root.progress);
            height: parent.height - 6px;
            background: @linear-gradient(90deg, Pal.accent-dark 0%, Pal.accent 100%);
            border-radius: 3px;
            animate width { duration: 120ms; easing: ease-out; }
        }
    }

    // Live detail (current file / phase).
    Rectangle {
        height: 22px;
        clip: true;
        Text {
            text: root.progress-label;
            font-size: 11px; color: Pal.dim;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component CompletePage inherits VerticalLayout {
    in property <string> app-name;
    in property <bool> success;
    in property <string> result-title;     // e.g. "X was updated" / "X was uninstalled"
    in property <string> result-message;
    in property <[LaunchRow]> launch-items;
    callback launch-toggled(string, bool);
    spacing: 12px;
    Rectangle { vertical-stretch: 1; }
    Rectangle {
        width: 64px; height: 64px;
        x: (parent.width - self.width) / 2;
        border-radius: 6px; border-width: 3px;
        border-color: root.success ? #2bbf6a : Pal.danger;
        background: root.success ? #143b27 : #3b1414;
        Path {
            width: 32px; height: 32px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            stroke: root.success ? #36d27e : #ff6b6b; stroke-width: 3px; fill: transparent;
            commands: root.success ? "M 5 16 L 13 24 L 27 6" : "M 6 6 L 26 26 M 26 6 L 6 26";
        }
    }
    Text {
        text: root.result-title != "" ? root.result-title
            : (root.success ? I18n.tr("done.is_installed", I18n.rev) : I18n.tr("done.install_failed_title", I18n.rev));
        font-size: 21px; font-weight: 900; color: white; horizontal-alignment: center;
    }
    Text { text: result-message; font-size: 12px; color: Pal.dim; horizontal-alignment: center; wrap: word-wrap; }

    // Opt-in: pick what to start when closing the installer.
    if root.success && root.launch-items.length > 0 : Rectangle {
        horizontal-stretch: 0;
        x: (parent.width - self.width) / 2;
        width: min(parent.width, 380px);
        background: Pal.panel;
        border-radius: 6px; border-width: 2px; border-color: Pal.border;
        VerticalLayout {
            padding: 14px; spacing: 10px;
            Text { text: I18n.tr("done.launch_now", I18n.rev); font-size: 12px; font-weight: 700; color: Pal.dim; }
            for it in root.launch-items : BrutalCheck {
                text: it.label;
                checked: it.checked;
                toggled => { root.launch-toggled(it.id, self.checked); }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component LegalPage inherits VerticalLayout {
    in property <string> doc-title;
    in property <[MdBlock]> blocks;
    in property <int> index;
    in property <int> count;
    in property <string> accept-text;
    // "Document 1 / 2", worded by Rust.
    in property <string> counter;
    // Non-empty when this document is not in the language the installer is shown in.
    in property <string> notice;
    in property <bool> require-scroll: false;
    in-out property <bool> accepted;
    callback accept-toggled(bool);
    callback open-url(string);
    spacing: 10px;

    // Moving between the Terms and the Privacy Policy re-used the SAME ScrollView, so the
    // second document opened wherever the first one had been left — usually near its end,
    // which reads as an empty page and hides everything above it.
    changed index => { sv.viewport-y = 0px; }

    // Has the reader reached the bottom? A document SHORTER than the viewport counts as
    // read, or a short privacy policy could never be accepted at all. The 12px slack
    // absorbs sub-pixel layout rounding — without it the last line can sit permanently one
    // fraction of a pixel out of reach, which is indistinguishable from a broken checkbox.
    property <bool> at-end: sv.viewport-height <= sv.visible-height
        || (-sv.viewport-y + sv.visible-height) >= (sv.viewport-height - 12px);
    // Once accepted, stay unlocked: scrolling back up to re-read must not un-tick it.
    property <bool> may-accept: !root.require-scroll || root.at-end || root.accepted;
    HorizontalLayout {
        Text { text: doc-title; font-size: 22px; font-weight: 900; color: white; horizontal-stretch: 1; horizontal-alignment: I18n.rtl ? right : left; }
        Text { text: root.counter; font-size: 12px; font-weight: 700; color: Pal.dim; vertical-alignment: center; }
    }
    // Saying the document is in another language is part of consent: someone accepting
    // text they may not read should at least be told that is what is happening.
    if root.notice != "" : Rectangle {
        background: #2b2412;
        border-radius: 4px;
        border-width: 2px;
        border-color: #d98a1c;
        HorizontalLayout {
            padding: 8px;
            Text {
                text: root.notice;
                color: #f0c27a; font-size: 12px; font-weight: 700;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Pal.panel;
        border-radius: 6px;
        border-width: 2px;
        border-color: Pal.border;
        sv := ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 5px;
                for b in blocks : VerticalLayout {
                    // A level-5 row is a URL and nothing else, so the whole row is the hit
                    // target — no attempt to make a word inside a wrapped paragraph
                    // clickable, which a plain Text run cannot do.
                    if b.level == 5 : Rectangle {
                        // The row's height comes from the LAYOUT, not from a `height:`
                        // binding on `linktxt.preferred-height`. That binding asked the
                        // Text for a height while the Text was still asking the Rectangle
                        // for its width — the cycle resolved to zero and the link rendered
                        // as nothing at all, which looked exactly like the parser having
                        // dropped it.
                        ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url(b.link); }
                        }
                        HorizontalLayout {
                            padding-top: 3px;
                            padding-bottom: 3px;
                            linktxt := Text {
                                text: "🔗  " + b.text;
                                font-size: 12px;
                                font-weight: 700;
                                // Brightens under the pointer. Slint's Text has no
                                // underline, so colour + cursor + the glyph are what say
                                // "clickable".
                                color: ta.has-hover ? white : Pal.accent;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if b.level != 5 : Text {
                        text: b.level == 4 ? "•  " + b.text : b.text;
                        horizontal-alignment: I18n.rtl ? right : left;
                        font-size: b.level == 1 ? 18px : (b.level == 2 ? 15px : (b.level == 3 ? 13px : 12px));
                        font-weight: (b.level >= 1 && b.level <= 3) ? 800 : 400;
                        color: (b.level >= 1 && b.level <= 3) ? white : Pal.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        // FIXED height, and that is what breaks the binding loop rather than any phrasing
        // of the hint. Anything in this row whose size depends on `may-accept` — its
        // presence, or even its text, since a Text's preferred height follows its content —
        // feeds back into the ScrollView's height and therefore into whether the end has
        // been reached. Pin the row and the measurement stops depending on its own result.
        height: 26px;
        BrutalCheck {
            text: root.accept-text;
            checked: root.accepted;
            enabled: root.may-accept;
            controlled: true;
            // `checked` still reflects the old value (no self-toggle), so send its inverse.
            toggled => { if (root.may-accept) { root.accept-toggled(!self.checked); } }
        }
        // Says WHY the box is greyed out. A disabled control with no explanation reads as
        // a bug, and the reader's next move is to click it harder.
        //
        // ALWAYS present, showing an empty string when it has nothing to say. Making its
        // existence conditional on `may-accept` created a binding loop the compiler
        // refused: the hint changes the row's height, which changes the ScrollView's
        // height, which changes whether the end is reached, which decides the hint. Text
        // that appears and disappears must not be what the measurement depends on.
        // CONSTANT text, varying only in opacity. Two earlier attempts looped: making the
        // hint's EXISTENCE conditional, then its CONTENT — a Text's preferred height
        // follows its string, so either way the hint fed back into the ScrollView's height
        // and so into whether the end had been reached. Opacity is not a layout property,
        // so nothing here can influence the measurement it reacts to.
        Text {
            text: I18n.tr("legal.scroll_hint", I18n.rev);
            opacity: root.may-accept ? 0 : 1;
            font-size: 11px;
            color: Pal.dim;
            vertical-alignment: center;
            wrap: no-wrap;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component MaintenancePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    callback repair();
    callback update();
    callback uninstall();
    // "" = choose · "repair"/"update"/"uninstall" = confirmation pending (cancelable).
    property <string> pending: "";
    spacing: 12px;
    Text { text: app-name; font-size: 26px; font-weight: 900; color: white; }
    Text {
        text: root.installed-version != "" ? I18n.tr("maintenance.installed_version", I18n.rev) : I18n.tr("maintenance.installed", I18n.rev);
        font-size: 13px; color: Pal.dim;
    }
    Text { text: location; font-size: 12px; color: Pal.text; wrap: word-wrap; }

    // Update-available banner.
    if root.update-available : Rectangle {
        height: 34px;
        background: #122b1c;
        border-radius: 4px; border-width: 2px; border-color: #2bbf6a;
        HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 8px; alignment: start;
            Text {
                text: I18n.tr("maintenance.update_available", I18n.rev);
                color: #8be0ab; font-size: 12px; font-weight: 700; vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 10px; }

    if root.pending == "" : VerticalLayout {
        spacing: 12px;
        Text { text: I18n.tr("maintenance.question", I18n.rev); font-size: 13px; font-weight: 700; color: Pal.dim; }
        HorizontalLayout {
            spacing: 12px;
            // Update only appears when a newer version is bundled.
            if root.update-available : BrutalBtn { text: I18n.tr("maintenance.update", I18n.rev); primary: true; clicked => { root.pending = "update"; } }
            BrutalBtn { text: I18n.tr("maintenance.repair", I18n.rev); primary: !root.update-available; clicked => { root.pending = "repair"; } }
            BrutalBtn { text: I18n.tr("maintenance.uninstall", I18n.rev); clicked => { root.pending = "uninstall"; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if root.pending != "" : VerticalLayout {
        spacing: 14px;
        Text {
            text: root.pending == "uninstall"
                ? I18n.tr("maintenance.confirm_uninstall", I18n.rev)
                : (root.pending == "update"
                    ? I18n.tr("maintenance.confirm_update", I18n.rev)
                    : I18n.tr("maintenance.confirm_repair", I18n.rev));
            font-size: 14px; font-weight: 700; color: Pal.text; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 12px;
            BrutalBtn {
                text: root.pending == "uninstall" ? I18n.tr("maintenance.yes_uninstall", I18n.rev)
                    : (root.pending == "update" ? I18n.tr("maintenance.yes_update", I18n.rev) : I18n.tr("maintenance.yes_repair", I18n.rev));
                primary: true;
                clicked => {
                    if (root.pending == "uninstall") { root.uninstall(); }
                    else if (root.pending == "update") { root.update(); }
                    else { root.repair(); }
                    root.pending = "";
                }
            }
            BrutalBtn { text: I18n.tr("ui.cancel", I18n.rev); clicked => { root.pending = ""; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// ── Main window (frameless: OS decorations disabled from Rust) ──
export component MainWindow inherits Window {
    title: "BetterInstaller";
    icon: @image-url("../../../BetterInstaller.png");
    // Sized for the page that needs the most room, not the least.
    //
    // At 800x560 the chrome — 42px title bar, 28px padding top and bottom, 20px gap, a
    // 46px button row — took 164px before a single line of content, leaving under 400px.
    // Every page that lists things (components, themes, a policy) therefore opened
    // already scrolled, cut mid-row. Scrolling is fine as a fallback; it is not fine as
    // the default state of a five-item list.
    preferred-width: 980px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 640px;
    background: Pal.bg;
    no-frame: true;

    in property <int> page: 0;
    in property <bool> maintenance: false;
    in property <string> maintenance-verb: "Maintenance";
    in property <string> install-location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    in property <string> app-name: "Application";
    in property <image> app-logo;
    in property <string> app-version: "1.0.0";
    in property <string> publisher: "";
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <[LaunchRow]> launch-items;
    in-out property <string> install-dir;
    in property <[OptionRow]> options;
    in property <[CompRow]> components;
    in property <string> legal-title;
    in property <[MdBlock]> legal-blocks;
    in property <string> legal-accept-text: "I have read and accept this document.";
    in property <string> legal-counter;
    in property <string> legal-notice;
    in property <bool> legal-require-scroll: false;
    in property <int> legal-index: 0;
    in property <int> legal-count: 0;
    in-out property <bool> legal-accepted: false;
    in property <float> progress: 0;
    in property <string> progress-label;
    in property <bool> can-proceed: true;
    in property <bool> success: true;
    in property <string> result-message;
    in property <string> result-title;
    in property <color> accent: #3b82f6;

    // The one-time picker shown over the Done page (a `swatch` option that asked
    // to be shown again with `show_at_end`). Answering it rewrites the handoff.
    in-out property <bool> final-visible: false;
    in property <[SwatchRow]> final-previews;
    in property <string> final-title: "Pick a look";
    in property <string> final-hint;
    in-out property <string> final-value;
    callback final-picked(string);
    callback final-apply();
    callback final-skip();

    // Native names of the available languages, and which one is showing.
    in property <[string]> language-names;
    in property <int> language-index: 0;
    callback language-picked(int);

    callback go-back();
    callback go-next();
    callback install();
    callback finish();
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    callback option-choice-picked(string, int);
    callback reset-options();
    callback component-toggled(string, bool);
    callback legal-accept-toggled(bool);
    callback open-url(string);
    callback browse-location();
    callback launch-toggled(string, bool);
    callback repair();
    callback update-app();
    callback uninstall-app();
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    VerticalLayout {
        TitleBar {
            title: "BetterInstaller  —  " + root.app-name;
            start-drag => { root.start-drag(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;          // fill the window below the title bar
            // Sidebar
            Rectangle {
                width: 216px;
                background: #11151d;
                Rectangle { x: parent.width - 2px; width: 2px; background: Pal.border; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    // Branding header: the app's logo (if provided) + the app name.
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        // On a WHITE ROUNDED PLATE, the way an app icon sits everywhere else.
                        // BMM's mark is a dark glyph on transparency and this sidebar is
                        // #11151d, so without one it reads as a smudge — as something that
                        // failed to load rather than as branding, in the first place anybody
                        // looks. 34px around a 26px image leaves 4px on every side, so a mark
                        // that runs to the edge of its own bitmap never touches the radius.
                        //
                        // Both branches, on purpose: a plate that appeared only when a logo
                        // was configured would make BetterInstaller's own fallback look like
                        // the broken case.
                        if root.app-logo.width > 0 : Rectangle {
                            width: 34px; height: 34px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                source: root.app-logo;
                                width: 26px; height: 26px;
                                image-fit: contain;
                            }
                        }
                        if root.app-logo.width <= 0 : Rectangle {
                            width: 34px; height: 34px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                source: @image-url("../../../BetterInstaller.png");
                                width: 26px; height: 26px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: root.app-name;
                            font-size: 16px; font-weight: 900; color: white;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }   // push the steps toward the bottom
                    VerticalLayout {
                        spacing: 16px;
                        StepItem { label: I18n.tr("steps.welcome", I18n.rev); index: 0; current: root.page; }
                        // Terms + Setup are only part of a fresh install.
                        if !root.maintenance && root.legal-count > 0 : StepItem { label: I18n.tr("steps.terms", I18n.rev); index: 1; current: root.page; }
                        if !root.maintenance : StepItem { label: I18n.tr("steps.setup", I18n.rev); index: 2; current: root.page; }
                        // The action step: "Install" for a fresh install, else the
                        // maintenance verb (Repair / Update / Uninstall).
                        StepItem { label: root.maintenance ? root.maintenance-verb : I18n.tr("steps.install", I18n.rev); index: 3; current: root.page; }
                        StepItem { label: I18n.tr("steps.done", I18n.rev); index: 4; current: root.page; }
                    }
                    // The language picker. Offered until the install starts: after that
                    // the Done page is the only one left, and switching there would
                    // translate the buttons but not the result already written.
                    if root.page <= 2 && root.language-names.length > 1 : VerticalLayout {
                        padding-top: 18px;
                        spacing: 5px;
                        Text {
                            text: I18n.tr("ui.language", I18n.rev);
                            font-size: 11px; font-weight: 700; color: Pal.dim;
                        }
                        ComboBox {
                            height: 34px;
                            model: root.language-names;
                            current-index: root.language-index;
                            selected => { root.language-picked(self.current-index); }
                        }
                    }
                }
            }
            // Content
            Rectangle {
                background: Pal.bg;
                VerticalLayout {
                    // Trimmed from 28/20. Padding that costs 96px of vertical room on a
                    // list page is not breathing room, it is a scrollbar.
                    padding: 22px;
                    spacing: 14px;          // breathing room between content and the button bar
                    Rectangle {
                        vertical-stretch: 1;
                        if root.page == 0 && root.maintenance : MaintenancePage {
                            app-name: root.app-name;
                            location: root.install-location;
                            installed-version: root.installed-version;
                            new-version: root.app-version;
                            update-available: root.update-available;
                            repair => { root.repair(); }
                            update => { root.update-app(); }
                            uninstall => { root.uninstall-app(); }
                        }
                        if root.page == 0 && !root.maintenance : WelcomePage {
                            app-name: root.app-name;
                            app-version: root.app-version;
                            publisher: root.publisher;
                            signed: root.signed;
                            signature-status: root.signature-status;
                            components: root.components;
                            install-dir <=> root.install-dir;
                            component-toggled(id, v) => { root.component-toggled(id, v); }
                            browse => { root.browse-location(); }
                        }
                        if root.page == 1 : LegalPage {
                            doc-title: root.legal-title;
                            blocks: root.legal-blocks;
                            index: root.legal-index;
                            count: root.legal-count;
                            accept-text: root.legal-accept-text;
                            counter: root.legal-counter;
                            notice: root.legal-notice;
                            require-scroll: root.legal-require-scroll;
                            accepted: root.legal-accepted;
                            accept-toggled(v) => { root.legal-accept-toggled(v); }
                            open-url(u) => { root.open-url(u); }
                        }
                        if root.page == 2 : SetupPage {
                            options: root.options;
                            option-bool-changed(id, v) => { root.option-bool-changed(id, v); }
                            option-select-changed(id, v) => { root.option-select-changed(id, v); }
                            option-choice-picked(id, i) => { root.option-choice-picked(id, i); }
                            reset => { root.reset-options(); }
                        }
                        if root.page == 3 : ProgressPage {
                            progress: root.progress;
                            progress-label: root.progress-label;
                            installing-label: root.maintenance ? root.maintenance-verb + "…" : I18n.tr("progress.installing", I18n.rev);
                        }
                        if root.page == 4 : CompletePage {
                            app-name: root.app-name;
                            success: root.success;
                            result-title: root.result-title;
                            result-message: root.result-message;
                            launch-items: root.launch-items;
                            launch-toggled(id, v) => { root.launch-toggled(id, v); }
                        }
                    }
                    HorizontalLayout {
                        height: 46px;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        if root.page == 1 || root.page == 2 : BrutalBtn {
                            text: I18n.tr("ui.back", I18n.rev);
                            clicked => { root.go-back(); }
                        }
                        if (root.page == 0 && !root.maintenance) || root.page == 1 : BrutalBtn {
                            text: I18n.tr("ui.next", I18n.rev); primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.go-next(); }
                        }
                        if root.page == 2 : BrutalBtn {
                            text: I18n.tr("ui.install", I18n.rev); primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.install(); }
                        }
                        if root.page == 4 : BrutalBtn {
                            text: I18n.tr("ui.finish", I18n.rev); primary: true;
                            clicked => { root.finish(); }
                        }
                    }
                }
            }
        }
    }

    // ── The one-time picker, over everything ──────────────────────────────
    //
    // A sibling of the page layout rather than part of the Done page, so it dims
    // the sidebar and the title bar too: at this point the install is finished
    // and there is exactly one thing left to answer.
    if root.final-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #04060be8;
        // Swallows clicks so nothing behind the overlay stays live.
        TouchArea { width: parent.width; height: parent.height; }

        Rectangle {
            // 502px is three columns plus the 22px padding on each side, so the grid is
            // never the thing that decides the dialog's width.
            width: min(parent.width - 56px, 502px);
            // Taller than it was. Three columns turn thirteen themes into five rows (650px),
            // and 470px minus a title, a hint and a 46px button row left barely two and a
            // half of them visible on a window that is 760px tall.
            height: min(parent.height - 56px, 640px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Pal.panel;
            border-radius: 9px;
            border-width: 2px;
            border-color: Pal.border;
            drop-shadow-offset-x: 6px;
            drop-shadow-offset-y: 6px;
            drop-shadow-blur: 0px;
            drop-shadow-color: Pal.shadow;

            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text {
                    text: root.final-title;
                    font-size: 19px; font-weight: 900; color: white;
                }
                if root.final-hint != "" : Text {
                    text: root.final-hint;
                    font-size: 11px; color: Pal.dim; wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-height: final-grid.content-height;
                    viewport-width: final-grid.content-width;
                    // Three columns, and the width comes FROM the grid. The 458px that used
                    // to be written here was three columns' worth of pixels handed to a
                    // four-column component, which is how the fourth column ended up outside
                    // the viewport with nothing to say so.
                    final-grid := SwatchGrid {
                        cols: 3;
                        width: self.content-width;
                        rows: root.final-previews;
                        value: root.final-value;
                        picked(v) => { root.final-picked(v); }
                    }
                }
                HorizontalLayout {
                    height: 46px;
                    spacing: 12px;
                    Rectangle { horizontal-stretch: 1; }
                    BrutalBtn {
                        text: I18n.tr("final.skip", I18n.rev);
                        clicked => { root.final-skip(); }
                    }
                    BrutalBtn {
                        text: I18n.tr("final.apply", I18n.rev);
                        primary: true;
                        clicked => { root.final-apply(); }
                    }
                }
            }
        }
    }
}
