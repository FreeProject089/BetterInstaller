import { ComboBox, ScrollView, Palette } from "std-widgets.slint";

// The installer palette. Two built-in sets — dark (BMM's default theme: deep navy surfaces,
// BMM blue) and light — chosen by Rust from the OS app mode (`[theme] mode`, default
// "auto"), then overridden colour by colour from `[theme]` in installer.toml. Every colour
// on screen comes from here: a literal colour in a component is a colour that is wrong in
// one of the two modes.
export global Pal {
    in-out property <color> bg: #0b1020;
    in-out property <color> panel: #121a2b;
    in-out property <color> panel2: #18223a;
    in-out property <color> border: #24314d;
    in-out property <color> border-strong: #3a4a6b;
    in-out property <color> accent: #3b82f6;
    in-out property <color> accent-dark: #1d4ed8;
    in-out property <color> accent-hover: #5b9bff;
    // A selected card's fill: the accent at low strength.
    in-out property <color> accent-soft: #3b82f61f;
    // Body text, headings ("ink") and secondary text.
    in-out property <color> text: #dbe4f0;
    in-out property <color> ink: #f5f8fc;
    in-out property <color> dim: #8a97ad;
    in-out property <color> on-accent: #ffffff;
    in-out property <color> danger: #ef4444;
    in-out property <color> danger-soft: #ef44441f;
    in-out property <color> success: #22c55e;
    in-out property <color> success-soft: #22c55e1f;
    in-out property <color> warn: #f59e0b;
    in-out property <color> warn-soft: #f59e0b1f;
    in-out property <color> shadow: #00000073;
    in-out property <color> sidebar: #0e1526;
    in-out property <color> titlebar: #0a0f1c;
    // The track of a switch that is off.
    in-out property <color> track: #2f3d5a;
}

// Every string on screen that is not product data comes through here.
//
// `tr(key, rev)` is answered by Rust from the runtime catalogues (bpkg-core/src/i18n.rs).
// `rev` is not used by the lookup: passing it makes every binding that shows a string
// depend on it, so bumping it after a language switch re-evaluates all of them at once.
// That is what lets the language change mid-flow without rebuilding the window.
export global I18n {
    in property <int> rev: 0;
    // Right-to-left language: text is right-aligned. The layout itself is NOT mirrored
    // (Slint lays out left to right); see the note at the entry point in main.rs.
    in property <bool> rtl: false;
    pure callback tr(string, int) -> string;
}

// One tile of a `swatch` option: a value, a name, and the four colors the little
// fake window in the tile is painted with.
export struct SwatchRow {
    value: string,
    label: string,
    bg: color,
    surface: color,
    accent: color,
    ink: color,
}

// One card of an option shown as `cards` (a choice, with a line on what picking it does).
export struct CardRow {
    value: string,
    title: string,
    description: string,
    recommended: bool,
    selected: bool,
}

export struct OptionRow {
    id: string,
    kind: string,
    // The `[[setup_group]]` this row belongs to: each group is its own step.
    group-id: string,
    label: string,
    description: string,
    // For `select`: the values (written to the handoff) and, index for index, what the
    // user reads. The dropdown shows the labels and reports an index, so a translated
    // label can never leak into the handoff as a value.
    choices: [string],
    choice-labels: [string],
    choice-index: int,
    bool-value: bool,
    string-value: string,
    previews: [SwatchRow],
    // Non-empty: the option is shown as these cards instead of a switch or a dropdown.
    cards: [CardRow],
    // A required choice nobody has made yet ("Choose one to continue").
    needs-answer: bool,
    // "Default: On", already translated. Shown on every switch so the default is visible
    // without having to remember it or reset the page.
    default-label: string,
    is-default: bool,
    sends-data: bool,
    // Non-empty on the first row of a group: the heading drawn above that row.
    header: string,
    header-description: string,
    // A child option (`parent` in installer.toml) is drawn indented under its parent, and
    // only while `shown`; an option a preset card decides is shown only under its `custom`
    // card. Top-level rows are otherwise always shown.
    shown: bool,
    child: bool,
    // Non-empty on a ticked parent that has children: the text of its "Choose" / "Hide" link.
    expander: string,
}

export struct CompRow {
    id: string,
    name: string,
    description: string,
    size: string,
    required: bool,
    checked: bool,
}

// A rendered markdown block. level: 0 paragraph · 1/2/3 heading · 4 bullet · 5 link.
//
// `link` is the URL a level-5 row opens. It is a separate field rather than a convention
// on `text` so the view never has to guess whether a line happens to look like an address.
export struct MdBlock {
    text: string,
    level: int,
    link: string,
}

// An opt-in "launch now" checkbox on the Done page.
export struct LaunchRow {
    id: string,
    label: string,
    checked: bool,
}

// One entry of the sidebar stepper. state: 0 ahead · 1 current · 2 done.
export struct StepRow {
    label: string,
    state: int,
}

// ── Button ──
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    min-width: 104px;
    border-radius: 8px;
    border-width: primary ? 0px : 1px;
    border-color: ta.has-hover && enabled ? Pal.border-strong : Pal.border;
    background: !enabled ? Pal.panel2
        : (primary ? (ta.pressed ? Pal.accent-dark : (ta.has-hover ? Pal.accent-hover : Pal.accent))
                   : (ta.pressed ? Pal.panel2 : (ta.has-hover ? Pal.panel2 : Pal.panel)));
    drop-shadow-offset-y: primary && enabled ? 2px : 0px;
    drop-shadow-blur: primary && enabled ? 10px : 0px;
    drop-shadow-color: primary && enabled ? Pal.accent.with-alpha(0.35) : transparent;
    animate background { duration: 90ms; }
    HorizontalLayout {
        alignment: center;
        // The label grows the button: a long translation never runs into the edges.
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: !root.enabled ? Pal.dim : (root.primary ? Pal.on-accent : Pal.ink);
            font-size: 14px;
            font-weight: 650;
            vertical-alignment: center;
            // One line, never clipped: a wrapped label inside a 40px button would be cut
            // in half rather than wrap visibly.
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// ── Checkbox ──
component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    // When true, the check never self-toggles: the parent owns `checked` and
    // updates it in response to `toggled`. Keeps a re-used checkbox in sync.
    in property <bool> controlled: false;
    callback toggled;
    height: 24px;
    opacity: root.enabled ? 1.0 : 0.55;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            border-width: root.checked ? 0px : 1.5px;
            border-color: ta.has-hover ? Pal.accent : Pal.border-strong;
            background: root.checked ? Pal.accent : Pal.panel;
            Path {
                visible: root.checked;
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1.5 6.5 L 4.8 9.8 L 10.5 2.5";
                stroke: Pal.on-accent;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: Pal.text;
            font-size: 13px;
            vertical-alignment: center;
            // Elided, not clipped: a French label is often a third longer than the
            // English one it replaced, and a fixed-height row cannot grow to wrap.
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if !root.controlled { root.checked = !root.checked; }
            root.toggled();
        }
    }
}

// ── A switch (on/off), drawn rather than a checkbox: it reads as a setting ──
component Toggle inherits Rectangle {
    in property <bool> on;
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Pal.accent : Pal.track;
    animate background { duration: 120ms; }
    Rectangle {
        width: 16px;
        height: 16px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

// ── Window control button (minimize / maximize / close) ──
component WinBtn inherits Rectangle {
    in property <string> kind;   // "min" | "max" | "close"
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.kind == "close" ? Pal.danger : Pal.panel2) : transparent;
    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: ta.has-hover && root.kind == "close" ? #ffffff : Pal.text;
        stroke-width: 1.2px;
        fill: transparent;
        commands: root.kind == "min" ? "M 0 5 L 10 5"
                : root.kind == "max" ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
                : "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Custom title bar (drag + window controls) ──
component TitleBar inherits Rectangle {
    in property <string> title;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    height: 38px;
    background: Pal.titlebar;
    Rectangle { y: parent.height - 1px; height: 1px; background: Pal.border; }
    HorizontalLayout {
        drag := TouchArea {
            horizontal-stretch: 1;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-drag();
                }
            }
            HorizontalLayout {
                padding-left: 14px;
                spacing: 9px;
                alignment: start;
                Image {
                    source: @image-url("../../../BetterInstaller.png");
                    width: 16px; height: 16px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
                Text {
                    text: root.title;
                    color: Pal.dim; font-size: 12px; font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        WinBtn { kind: "min"; clicked => { root.minimize(); } }
        WinBtn { kind: "max"; clicked => { root.toggle-maximize(); } }
        WinBtn { kind: "close"; clicked => { root.close-window(); } }
    }
}

// ── Sidebar stepper: numbered dots joined by a line, a check once a step is done ──
component StepDot inherits VerticalLayout {
    in property <int> index;
    in property <string> label;
    // 0 ahead · 1 current · 2 done
    in property <int> state;
    in property <bool> connector: true;
    spacing: 0px;
    HorizontalLayout {
        spacing: 12px;
        height: 26px;
        Rectangle {
            width: 24px;
            height: 24px;
            y: 1px;
            border-radius: 12px;
            border-width: root.state == 0 ? 1.5px : 0px;
            border-color: Pal.border-strong;
            background: root.state == 0 ? transparent : Pal.accent;
            drop-shadow-blur: root.state == 1 ? 8px : 0px;
            drop-shadow-color: Pal.accent.with-alpha(0.45);
            if root.state != 2 : Text {
                text: root.index + 1;
                font-size: 11px;
                font-weight: 700;
                color: root.state == 1 ? Pal.on-accent : Pal.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.state == 2 : Path {
                width: 11px; height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1 5.5 L 4.3 8.8 L 10 2";
                stroke: Pal.on-accent; stroke-width: 2px; fill: transparent;
            }
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: root.state == 1 ? Pal.ink : (root.state == 2 ? Pal.text : Pal.dim);
            font-weight: root.state == 1 ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    // The connector to the next dot; none under the last one.
    if root.connector : Rectangle {
        height: 14px;
        Rectangle {
            x: 11px;
            width: 2px;
            height: parent.height;
            border-radius: 1px;
            background: root.state == 2 ? Pal.accent : Pal.border;
        }
    }
}

// The steps before the install come from Rust (they change with the install type); the
// install and the end are always the last two, and follow the page on their own — the
// worker threads that move to them never have to touch the sidebar.
component Stepper inherits VerticalLayout {
    in property <[StepRow]> steps;
    in property <int> page;
    in property <string> install-label;
    in property <string> done-label;
    property <bool> finished: root.page == 3 || root.page == 4;
    spacing: 0px;
    for s[i] in root.steps : StepDot {
        index: i;
        label: s.label;
        state: root.finished ? 2 : s.state;
    }
    StepDot {
        index: root.steps.length;
        label: root.install-label;
        state: root.page == 4 ? 2 : (root.page == 3 ? 1 : 0);
    }
    StepDot {
        index: root.steps.length + 1;
        label: root.done-label;
        state: root.page == 4 ? 1 : 0;
        connector: false;
    }
}

// A small pill next to a label ("Sends data", "Recommended", "Changed").
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Pal.accent;
    height: 20px;
    border-radius: 10px;
    background: root.tint.with-alpha(0.14);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 10.5px;
            font-weight: 700;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// The heading of a page: a title and one line under it.
component PageHead inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text {
        text: root.title;
        font-size: 24px; font-weight: 800; color: Pal.ink;
        wrap: word-wrap;
        horizontal-alignment: I18n.rtl ? right : left;
    }
    if root.subtitle != "" : Text {
        text: root.subtitle;
        font-size: 13px; color: Pal.dim; wrap: word-wrap;
        horizontal-alignment: I18n.rtl ? right : left;
    }
}

// ── A choice card: radio dot, title, one line on what it does ──
//
// The TouchArea comes FIRST and the layout second, the pattern the legal page's link rows
// use: the card's height is the layout's, so a description that wraps to three lines makes
// a taller card instead of being clipped.
component ChoiceCardView inherits Rectangle {
    in property <CardRow> card;
    in property <string> recommended-text;
    callback picked();
    // Never takes a share of leftover height: a short page would otherwise blow two
    // cards up to fill it.
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: root.card.selected ? 2px : 1px;
    border-color: root.card.selected ? Pal.accent : (ta.has-hover ? Pal.border-strong : Pal.border);
    background: root.card.selected ? Pal.accent-soft : (ta.has-hover ? Pal.panel2 : Pal.panel);
    animate background, border-color { duration: 90ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.card.selected ? Pal.accent : Pal.border-strong;
                background: transparent;
                Rectangle {
                    visible: root.card.selected;
                    width: 8px; height: 8px;
                    x: 5px; y: 5px;
                    border-radius: 4px;
                    background: Pal.accent;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.card.title;
                    font-size: 14px; font-weight: 700; color: Pal.ink;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    horizontal-alignment: I18n.rtl ? right : left;
                }
                if root.card.recommended : Tag { text: root.recommended-text; tint: Pal.success; }
            }
            if root.card.description != "" : Text {
                text: root.card.description;
                font-size: 12px; color: Pal.dim; wrap: word-wrap;
                horizontal-alignment: I18n.rtl ? right : left;
            }
        }
    }
}

// ── A swatch tile: a miniature app window painted in the choice's own colors ──
//
// Deliberately a caricature — a title bar, a sidebar, a card, a button — because
// the point is to recognise a look at a glance, not to preview a real screen. It
// is drawn from four colors and nothing else, so any project can declare one
// without shipping a screenshot per choice.
component SwatchTile inherits Rectangle {
    in property <SwatchRow> data;
    in property <bool> selected;
    callback picked();
    width: 176px;
    height: 136px;

    // The frame: the accent ring is what reads as "this one is chosen".
    Rectangle {
        y: 0;
        width: parent.width;
        height: 106px;
        background: root.data.bg;
        border-radius: 10px;
        border-width: root.selected ? 2.5px : 1px;
        border-color: root.selected ? Pal.accent : (ta.has-hover ? Pal.border-strong : Pal.border);
        clip: true;

        // Title bar + its three window buttons.
        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 16px;
            background: root.data.surface;
        }
        for d[i] in [0, 1, 2] : Rectangle {
            x: parent.width - 12px - (i * 9px);
            y: 6px;
            width: 5px; height: 5px;
            border-radius: 2.5px;
            background: root.data.ink;
            opacity: 0.35;
        }

        // Sidebar with three nav lines.
        Rectangle {
            x: 0; y: 16px;
            width: 42px; height: parent.height - 16px;
            background: root.data.surface;
        }
        for n[i] in [0, 1, 2] : Rectangle {
            x: 8px;
            y: 28px + (i * 12px);
            width: 26px; height: 4px;
            border-radius: 2px;
            background: i == 0 ? root.data.accent : root.data.ink;
            opacity: i == 0 ? 1.0 : 0.3;
        }

        // Content card: a heading, two lines of text, and a primary button.
        Rectangle {
            x: 52px; y: 26px;
            width: parent.width - 64px; height: parent.height - 38px;
            background: root.data.surface;
            border-radius: 5px;
            Rectangle {
                x: 8px; y: 8px; width: 46px; height: 5px;
                border-radius: 2px; background: root.data.ink;
            }
            Rectangle {
                x: 8px; y: 20px; width: parent.width - 22px; height: 3px;
                border-radius: 1.5px; background: root.data.ink; opacity: 0.32;
            }
            Rectangle {
                x: 8px; y: 28px; width: (parent.width - 22px) * 0.6; height: 3px;
                border-radius: 1.5px; background: root.data.ink; opacity: 0.32;
            }
            Rectangle {
                x: 8px; y: parent.height - 18px;
                width: 38px; height: 12px;
                border-radius: 3px; background: root.data.accent;
            }
        }
        // The chosen tile wears a check in its corner, so the choice still reads when the
        // theme's own accent happens to be the installer's blue.
        if root.selected : Rectangle {
            x: 6px; y: parent.height - 26px;
            width: 20px; height: 20px;
            border-radius: 10px;
            background: Pal.accent;
            Path {
                width: 10px; height: 10px;
                x: 5px; y: 5px;
                commands: "M 0.5 5 L 3.8 8.3 L 9.5 1.5";
                stroke: Pal.on-accent; stroke-width: 2px; fill: transparent;
            }
        }
    }

    Text {
        y: 112px;
        width: parent.width;
        text: root.data.label;
        font-size: 12px;
        font-weight: root.selected ? 700 : 500;
        color: root.selected ? Pal.ink : Pal.dim;
        horizontal-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// A wrapping grid of tiles. Slint has no flow layout, so the position is arithmetic —
// and the container states its own height, or a ScrollView around it would measure zero
// and show nothing.
component SwatchGrid inherits Rectangle {
    in property <[SwatchRow]> rows;
    in property <string> value;
    callback picked(string);
    // The tiles are positioned absolutely, so this Rectangle has no PREFERRED height of
    // its own — and a preferred height is exactly what a ScrollView sizes its viewport
    // from. The needed height is therefore PUBLISHED, and every ScrollView holding one of
    // these binds its viewport-height to it rather than guessing.
    //
    // An INPUT, because the final dialog shows the same grid narrower.
    in property <int> cols: 3;
    // Derived, not asserted beside `cols`, so the two can never disagree.
    out property <length> content-width: cols * 188px - 12px;
    out property <length> content-height: (floor((max(rows.length, 1) - 1) / cols) + 1) * 148px;
    // min-height, not height: a LAYOUT sizes its children from min/preferred and ignores
    // an explicit height, so the copy on the Configuration page would be allotted no room
    // and overlap whatever follows it.
    min-height: content-height;
    for sw[i] in rows : SwatchTile {
        x: (i - floor(i / cols) * cols) * 188px;
        y: floor(i / cols) * 148px;
        data: sw;
        selected: sw.value == root.value;
        picked => { root.picked(sw.value); }
    }
}

// ── Welcome: what is being installed, and how ──
component WelcomePage inherits VerticalLayout {
    in property <string> app-name;
    in property <image> app-logo;
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <string> mode;
    in property <[string]> recommended-items;
    callback mode-picked(string);
    spacing: 14px;

    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        Rectangle {
            width: 56px; height: 56px;
            border-radius: 14px;
            background: #ffffff;
            border-width: 1px;
            border-color: Pal.border;
            Image {
                source: root.app-logo.width > 0 ? root.app-logo : @image-url("../../../BetterInstaller.png");
                width: 40px; height: 40px;
                image-fit: contain;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: I18n.tr("welcome.title", I18n.rev); font-size: 26px; font-weight: 800; color: Pal.ink; wrap: word-wrap; }
            Text { text: I18n.tr("welcome.version", I18n.rev); font-size: 13px; color: Pal.dim; }
        }
    }

    // Signature / publisher trust badge.
    HorizontalLayout {
        alignment: start;
        Rectangle {
            height: 30px;
            border-radius: 15px;
            background: root.signed ? Pal.success-soft : Pal.danger-soft;
            HorizontalLayout {
                padding-left: 10px; padding-right: 14px; spacing: 8px;
                alignment: start;
                Path {
                    width: 14px; height: 14px;
                    y: (parent.height - self.height) / 2;
                    fill: root.signed ? Pal.success : Pal.danger;
                    commands: "M 7 0 L 13 2.6 L 13 7 C 13 10.5 10.4 13.1 7 14 C 3.6 13.1 1 10.5 1 7 L 1 2.6 Z";
                }
                Text {
                    text: root.signature-status;
                    color: root.signed ? Pal.success : Pal.danger;
                    font-size: 12px; font-weight: 650;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle { height: 4px; }
    Text {
        text: I18n.tr("welcome.how", I18n.rev);
        font-size: 15px; font-weight: 700; color: Pal.ink;
    }

    ChoiceCardView {
        recommended-text: I18n.tr("setup.recommended", I18n.rev);
        card: {
            value: "recommended",
            title: I18n.tr("welcome.recommended", I18n.rev),
            description: I18n.tr("welcome.recommended_desc", I18n.rev),
            recommended: false,
            selected: root.mode == "recommended",
        };
        picked => { root.mode-picked("recommended"); }
    }
    // What "Recommended" puts on this PC, listed rather than left to trust.
    if root.mode == "recommended" && root.recommended-items.length > 0 : VerticalLayout {
        padding-left: 44px;
        spacing: 4px;
        for it in root.recommended-items : HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 5px; height: 5px; y: 6px;
                border-radius: 2.5px;
                background: Pal.accent;
            }
            Text { text: it; font-size: 12px; color: Pal.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
    ChoiceCardView {
        recommended-text: I18n.tr("setup.recommended", I18n.rev);
        card: {
            value: "custom",
            title: I18n.tr("welcome.custom", I18n.rev),
            description: I18n.tr("welcome.custom_desc", I18n.rev),
            recommended: false,
            selected: root.mode == "custom",
        };
        picked => { root.mode-picked("custom"); }
    }
    Rectangle { vertical-stretch: 1; }
}

// ── Location & components (a Custom install) ──
component LocationPage inherits VerticalLayout {
    in property <[CompRow]> components;
    in-out property <string> install-dir;
    in property <bool> offer-shortcuts;
    in property <bool> shortcut-start;
    in property <bool> shortcut-desktop;
    // "Start with Windows": offered when `[install] autostart` is set.
    in property <bool> offer-autostart;
    in property <bool> autostart;
    callback component-toggled(string, bool);
    callback browse();
    callback shortcut-toggled(string, bool);
    spacing: 10px;
    PageHead {
        title: I18n.tr("location.title", I18n.rev);
        subtitle: I18n.tr("location.hint", I18n.rev);
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            padding-right: 12px;
            padding-bottom: 6px;
            Text { text: I18n.tr("welcome.location", I18n.rev); font-size: 13px; font-weight: 700; color: Pal.ink; }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 40px;
                    horizontal-stretch: 1;
                    background: Pal.panel;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: input.has-focus ? Pal.accent : Pal.border;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        input := TextInput {
                            text <=> root.install-dir;
                            color: Pal.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }
                Btn { text: I18n.tr("ui.browse", I18n.rev); min-width: 96px; clicked => { root.browse(); } }
            }
            if root.components.length > 0 : Text {
                text: I18n.tr("welcome.components", I18n.rev);
                font-size: 13px; font-weight: 700; color: Pal.ink;
            }
            for c in root.components : Rectangle {
                background: Pal.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: c.checked ? Pal.accent.with-alpha(0.5) : Pal.border;
                // vertical-stretch: 0, or a layout hands every row a share of the leftover
                // height and two lines of text float in a third of the page.
                vertical-stretch: 0;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            width: 20px;
                            checked: c.checked;
                            enabled: !c.required;
                            toggled => { root.component-toggled(c.id, self.checked); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: c.name; font-size: 13px; font-weight: 700; color: Pal.ink; vertical-alignment: center; }
                            if c.required : Tag { text: I18n.tr("welcome.required", I18n.rev); }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: c.size; font-size: 12px; color: Pal.dim; vertical-alignment: center; }
                        }
                        if c.description != "" : Text { text: c.description; font-size: 12px; color: Pal.dim; wrap: word-wrap; }
                    }
                }
            }
            if root.offer-shortcuts || root.offer-autostart : Text {
                text: I18n.tr("location.shortcuts", I18n.rev);
                font-size: 13px; font-weight: 700; color: Pal.ink;
            }
            // Each choice with one line on what it does: a box alone says what it is
            // called, not what ticking it changes.
            if root.offer-shortcuts || root.offer-autostart : Rectangle {
                background: Pal.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Pal.border;
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    if root.offer-shortcuts : VerticalLayout {
                        spacing: 2px;
                        Check {
                            text: I18n.tr("location.start_menu", I18n.rev);
                            checked: root.shortcut-start;
                            controlled: true;
                            toggled => { root.shortcut-toggled("start", !self.checked); }
                        }
                        HorizontalLayout {
                            padding-left: 30px;
                            Text {
                                text: I18n.tr("location.start_menu_hint", I18n.rev);
                                font-size: 12px; color: Pal.dim; wrap: word-wrap;
                            }
                        }
                    }
                    if root.offer-shortcuts : VerticalLayout {
                        spacing: 2px;
                        Check {
                            text: I18n.tr("location.desktop", I18n.rev);
                            checked: root.shortcut-desktop;
                            controlled: true;
                            toggled => { root.shortcut-toggled("desktop", !self.checked); }
                        }
                        HorizontalLayout {
                            padding-left: 30px;
                            Text {
                                text: I18n.tr("location.desktop_hint", I18n.rev);
                                font-size: 12px; color: Pal.dim; wrap: word-wrap;
                            }
                        }
                    }
                    if root.offer-autostart : VerticalLayout {
                        spacing: 2px;
                        Check {
                            text: I18n.tr("location.autostart", I18n.rev);
                            checked: root.autostart;
                            controlled: true;
                            toggled => { root.shortcut-toggled("autostart", !self.checked); }
                        }
                        HorizontalLayout {
                            padding-left: 30px;
                            Text {
                                text: I18n.tr("location.autostart_hint", I18n.rev);
                                font-size: 12px; color: Pal.dim; wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// ── One step of setup: the options of one `[[setup_group]]` ──
component SetupPage inherits VerticalLayout {
    in property <[OptionRow]> options;
    in property <string> group;
    in property <string> title;
    in property <string> subtitle;
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    callback option-choice-picked(string, int);
    callback option-card-picked(string, string);
    callback option-expand-toggled(string);
    callback reset();
    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        PageHead {
            horizontal-stretch: 1;
            title: root.title;
            subtitle: root.subtitle;
        }
        // Undo every change in one click. Legal acceptance is not an option here and is
        // never touched by it.
        VerticalLayout {
            alignment: start;
            Btn {
                height: 32px;
                min-width: 0px;
                text: I18n.tr("setup.reset", I18n.rev);
                clicked => { root.reset(); }
            }
        }
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            // No spacing here: a hidden row must take no room at all, so each shown row
            // brings its own gap (padding-top) instead.
            spacing: 0px;
            padding-right: 12px;
            padding-bottom: 8px;
            for opt[i] in root.options : VerticalLayout {
              if opt.shown && opt.group-id == root.group : VerticalLayout {
                spacing: 8px;
                padding-top: opt.child ? 6px : 12px;
                padding-left: opt.child ? 26px : 0px;

                // ── Cards: the option is a choice between a few clear outcomes ──
                if opt.cards.length > 0 : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: opt.label;
                            font-size: 15px; font-weight: 700; color: Pal.ink;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            horizontal-alignment: I18n.rtl ? right : left;
                        }
                        if opt.sends-data : Tag { text: I18n.tr("setup.sends_data", I18n.rev); tint: Pal.warn; }
                    }
                    if opt.description != "" : Text {
                        text: opt.description; font-size: 12px; color: Pal.dim; wrap: word-wrap;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                    for card in opt.cards : ChoiceCardView {
                        card: card;
                        recommended-text: I18n.tr("setup.recommended", I18n.rev);
                        picked => { root.option-card-picked(opt.id, card.value); }
                    }
                    if opt.needs-answer : Text {
                        text: I18n.tr("setup.pick_one", I18n.rev);
                        font-size: 12px; font-weight: 650; color: Pal.warn;
                    }
                }

                // ── A swatch: a picture choice, as large tiles ──
                if opt.cards.length == 0 && opt.kind == "swatch" : VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: opt.label;
                        font-size: 15px; font-weight: 700; color: Pal.ink;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                    if opt.description != "" : Text {
                        text: opt.description; font-size: 12px; color: Pal.dim; wrap: word-wrap;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                    SwatchGrid {
                        cols: 3;
                        rows: opt.previews;
                        value: opt.string-value;
                        picked(v) => { root.option-select-changed(opt.id, v); }
                    }
                }

                // ── A switch or a dropdown, on a card ──
                if opt.cards.length == 0 && (opt.kind == "bool" || opt.kind == "select") : Rectangle {
                    vertical-stretch: 0;
                    background: opt.child ? Pal.panel2 : Pal.panel;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: opt.kind == "bool" && opt.bool-value ? Pal.accent.with-alpha(0.45) : Pal.border;
                    // A bool card toggles anywhere on it. The TouchArea is declared first so
                    // the card's height stays the layout's (see ChoiceCardView).
                    card-ta := TouchArea {
                        enabled: opt.kind == "bool";
                        mouse-cursor: opt.kind == "bool" ? pointer : default;
                        clicked => { root.option-bool-changed(opt.id, !opt.bool-value); }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: opt.child ? 9px : 12px;
                        padding-bottom: opt.child ? 9px : 12px;
                        spacing: 14px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                // Wraps: a label is never cut at the card's edge, in any language.
                                Text {
                                    text: opt.label;
                                    font-size: opt.child ? 13px : 14px; font-weight: 650; color: Pal.ink;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: I18n.rtl ? right : left;
                                }
                                if opt.sends-data : Tag { text: I18n.tr("setup.sends_data", I18n.rev); tint: Pal.warn; }
                            }
                            if opt.description != "" : Text {
                                text: opt.description; font-size: 12px; color: Pal.dim; wrap: word-wrap;
                                horizontal-alignment: I18n.rtl ? right : left;
                            }
                            // The default, always on screen, and whether this row has moved
                            // away from it.
                            HorizontalLayout {
                                spacing: 8px;
                                if opt.default-label != "" : Text {
                                    text: opt.default-label;
                                    font-size: 11px; color: Pal.dim;
                                    vertical-alignment: center;
                                }
                                if !opt.is-default : Tag { text: I18n.tr("setup.changed", I18n.rev); }
                                Rectangle { horizontal-stretch: 1; }
                                // "Choose" / "Hide": opens the child options of a ticked parent.
                                if opt.expander != "" : Rectangle {
                                    min-width: expander-text.preferred-width + 12px;
                                    border-radius: 6px;
                                    background: expander-ta.has-hover ? Pal.accent-soft : transparent;
                                    expander-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.option-expand-toggled(opt.id); }
                                    }
                                    expander-text := Text {
                                        text: opt.expander;
                                        font-size: 12px; font-weight: 700;
                                        color: Pal.accent;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                        if opt.kind == "bool" : VerticalLayout {
                            alignment: center;
                            Toggle { on: opt.bool-value; }
                        }
                        // Shows labels, reports an index: the value written is always one of
                        // `choices`, whatever language the label is in.
                        if opt.kind == "select" : VerticalLayout {
                            alignment: center;
                            ComboBox {
                                min-width: 200px;
                                height: 34px;
                                model: opt.choice-labels;
                                current-index: opt.choice-index;
                                selected => { root.option-choice-picked(opt.id, self.current-index); }
                            }
                        }
                    }
                }
              }
            }
            // Takes the leftover height so the rows above keep their own.
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component ProgressPage inherits VerticalLayout {
    in property <float> progress;
    in property <string> progress-label;
    in property <string> installing-label: "Installing…";
    spacing: 14px;
    Rectangle { vertical-stretch: 1; }

    // Big live percentage.
    Text {
        text: round(root.progress * 100) + "%";
        font-size: 56px; font-weight: 800; color: Pal.ink;
        horizontal-alignment: center;
    }
    Text {
        text: root.installing-label;
        font-size: 16px; font-weight: 650; color: Pal.text;
        horizontal-alignment: center;
    }

    Rectangle { height: 4px; }

    Rectangle {
        height: 10px;
        background: Pal.panel2;
        border-radius: 5px;
        Rectangle {
            x: 0; y: 0;
            width: max(0px, parent.width * root.progress);
            height: parent.height;
            background: @linear-gradient(90deg, Pal.accent-dark 0%, Pal.accent 100%);
            border-radius: 5px;
            animate width { duration: 160ms; easing: ease-out; }
        }
    }

    // Live detail (current file / phase).
    Rectangle {
        height: 22px;
        clip: true;
        Text {
            text: root.progress-label;
            font-size: 12px; color: Pal.dim;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component CompletePage inherits VerticalLayout {
    in property <string> app-name;
    in property <bool> success;
    in property <string> result-title;     // e.g. "X was updated" / "X was uninstalled"
    in property <string> result-message;
    in property <[LaunchRow]> launch-items;
    callback launch-toggled(string, bool);
    spacing: 12px;
    Rectangle { vertical-stretch: 1; }
    Rectangle {
        width: 72px; height: 72px;
        x: (parent.width - self.width) / 2;
        border-radius: 36px;
        background: root.success ? Pal.success-soft : Pal.danger-soft;
        Path {
            width: 30px; height: 30px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            stroke: root.success ? Pal.success : Pal.danger; stroke-width: 3px; fill: transparent;
            commands: root.success ? "M 3 15.5 L 11 23.5 L 27 6" : "M 5 5 L 25 25 M 25 5 L 5 25";
        }
    }
    Text {
        text: root.result-title != "" ? root.result-title
            : (root.success ? I18n.tr("done.is_installed", I18n.rev) : I18n.tr("done.install_failed_title", I18n.rev));
        font-size: 22px; font-weight: 800; color: Pal.ink; horizontal-alignment: center;
    }
    Text { text: root.result-message; font-size: 12px; color: Pal.dim; horizontal-alignment: center; wrap: word-wrap; }

    // Opt-in: pick what to start when closing the installer.
    if root.success && root.launch-items.length > 0 : Rectangle {
        horizontal-stretch: 0;
        x: (parent.width - self.width) / 2;
        width: min(parent.width, 400px);
        background: Pal.panel;
        border-radius: 10px; border-width: 1px; border-color: Pal.border;
        VerticalLayout {
            padding: 16px; spacing: 10px;
            Text { text: I18n.tr("done.launch_now", I18n.rev); font-size: 12px; font-weight: 700; color: Pal.dim; }
            for it in root.launch-items : Check {
                text: it.label;
                checked: it.checked;
                toggled => { root.launch-toggled(it.id, self.checked); }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

component LegalPage inherits VerticalLayout {
    in property <string> doc-title;
    in property <[MdBlock]> blocks;
    in property <int> index;
    in property <int> count;
    in property <string> accept-text;
    // "Document 1 / 2", worded by Rust.
    in property <string> counter;
    // Non-empty when this document is not in the language the installer is shown in.
    in property <string> notice;
    in property <bool> require-scroll: false;
    in-out property <bool> accepted;
    callback accept-toggled(bool);
    callback open-url(string);
    spacing: 10px;

    // Moving between the Terms and the Privacy Policy re-used the SAME ScrollView, so the
    // second document opened wherever the first one had been left — usually near its end,
    // which reads as an empty page and hides everything above it.
    changed index => { sv.viewport-y = 0px; }

    // Has the reader reached the bottom? A document SHORTER than the viewport counts as
    // read, or a short privacy policy could never be accepted at all. The 12px slack
    // absorbs sub-pixel layout rounding — without it the last line can sit permanently one
    // fraction of a pixel out of reach, which is indistinguishable from a broken checkbox.
    property <bool> at-end: sv.viewport-height <= sv.visible-height
        || (-sv.viewport-y + sv.visible-height) >= (sv.viewport-height - 12px);
    // Once accepted, stay unlocked: scrolling back up to re-read must not un-tick it.
    property <bool> may-accept: !root.require-scroll || root.at-end || root.accepted;
    HorizontalLayout {
        Text { text: root.doc-title; font-size: 24px; font-weight: 800; color: Pal.ink; horizontal-stretch: 1; horizontal-alignment: I18n.rtl ? right : left; }
        Text { text: root.counter; font-size: 12px; font-weight: 650; color: Pal.dim; vertical-alignment: center; }
    }
    // Saying the document is in another language is part of consent: someone accepting
    // text they may not read should at least be told that is what is happening.
    if root.notice != "" : Rectangle {
        background: Pal.warn-soft;
        border-radius: 8px;
        HorizontalLayout {
            padding: 10px;
            Text {
                text: root.notice;
                color: Pal.warn; font-size: 12px; font-weight: 650;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Pal.panel;
        border-radius: 10px;
        border-width: 1px;
        border-color: Pal.border;
        sv := ScrollView {
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                for b in root.blocks : VerticalLayout {
                    // A level-5 row is a URL and nothing else, so the whole row is the hit
                    // target — no attempt to make a word inside a wrapped paragraph
                    // clickable, which a plain Text run cannot do.
                    if b.level == 5 : Rectangle {
                        // The row's height comes from the LAYOUT, not from a `height:`
                        // binding on `linktxt.preferred-height`. That binding asked the
                        // Text for a height while the Text was still asking the Rectangle
                        // for its width — the cycle resolved to zero and the link rendered
                        // as nothing at all, which looked exactly like the parser having
                        // dropped it.
                        ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url(b.link); }
                        }
                        HorizontalLayout {
                            padding-top: 3px;
                            padding-bottom: 3px;
                            linktxt := Text {
                                text: "🔗  " + b.text;
                                font-size: 12px;
                                font-weight: 650;
                                // Brightens under the pointer. Slint's Text has no
                                // underline, so colour + cursor + the glyph are what say
                                // "clickable".
                                color: ta.has-hover ? Pal.accent-hover : Pal.accent;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if b.level != 5 : Text {
                        text: b.level == 4 ? "•  " + b.text : b.text;
                        horizontal-alignment: I18n.rtl ? right : left;
                        font-size: b.level == 1 ? 19px : (b.level == 2 ? 15px : (b.level == 3 ? 13.5px : 12.5px));
                        font-weight: (b.level >= 1 && b.level <= 3) ? 750 : 400;
                        color: (b.level >= 1 && b.level <= 3) ? Pal.ink : Pal.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        // FIXED height, and that is what breaks the binding loop rather than any phrasing
        // of the hint. Anything in this row whose size depends on `may-accept` — its
        // presence, or even its text, since a Text's preferred height follows its content —
        // feeds back into the ScrollView's height and therefore into whether the end has
        // been reached. Pin the row and the measurement stops depending on its own result.
        height: 26px;
        Check {
            text: root.accept-text;
            checked: root.accepted;
            enabled: root.may-accept;
            controlled: true;
            // `checked` still reflects the old value (no self-toggle), so send its inverse.
            toggled => { if (root.may-accept) { root.accept-toggled(!self.checked); } }
        }
        // Says WHY the box is greyed out. CONSTANT text, varying only in opacity: making the
        // hint's existence or its content conditional fed back into the ScrollView's height
        // and so into whether the end had been reached (a binding loop). Opacity is not a
        // layout property, so nothing here can influence the measurement it reacts to.
        Text {
            text: I18n.tr("legal.scroll_hint", I18n.rev);
            opacity: root.may-accept ? 0 : 1;
            font-size: 11px;
            color: Pal.dim;
            vertical-alignment: center;
            wrap: no-wrap;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component MaintenancePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    callback repair();
    callback update();
    callback uninstall();
    // "" = choose · "repair"/"update"/"uninstall" = confirmation pending (cancelable).
    property <string> pending: "";
    spacing: 12px;
    Text { text: root.app-name; font-size: 26px; font-weight: 800; color: Pal.ink; }
    Text {
        text: root.installed-version != "" ? I18n.tr("maintenance.installed_version", I18n.rev) : I18n.tr("maintenance.installed", I18n.rev);
        font-size: 13px; color: Pal.dim;
    }
    Text { text: root.location; font-size: 12px; color: Pal.text; wrap: word-wrap; }

    // Update-available banner.
    if root.update-available : HorizontalLayout {
        alignment: start;
        Rectangle {
            height: 30px;
            background: Pal.success-soft;
            border-radius: 15px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                Text {
                    text: I18n.tr("maintenance.update_available", I18n.rev);
                    color: Pal.success; font-size: 12px; font-weight: 650; vertical-alignment: center;
                }
            }
        }
    }
    Rectangle { height: 10px; }

    if root.pending == "" : VerticalLayout {
        spacing: 12px;
        Text { text: I18n.tr("maintenance.question", I18n.rev); font-size: 14px; font-weight: 700; color: Pal.ink; }
        HorizontalLayout {
            spacing: 12px;
            // Update only appears when a newer version is bundled.
            if root.update-available : Btn { text: I18n.tr("maintenance.update", I18n.rev); primary: true; clicked => { root.pending = "update"; } }
            Btn { text: I18n.tr("maintenance.repair", I18n.rev); primary: !root.update-available; clicked => { root.pending = "repair"; } }
            Btn { text: I18n.tr("maintenance.uninstall", I18n.rev); clicked => { root.pending = "uninstall"; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if root.pending != "" : VerticalLayout {
        spacing: 14px;
        Text {
            text: root.pending == "uninstall"
                ? I18n.tr("maintenance.confirm_uninstall", I18n.rev)
                : (root.pending == "update"
                    ? I18n.tr("maintenance.confirm_update", I18n.rev)
                    : I18n.tr("maintenance.confirm_repair", I18n.rev));
            font-size: 14px; font-weight: 650; color: Pal.text; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 12px;
            Btn {
                text: root.pending == "uninstall" ? I18n.tr("maintenance.yes_uninstall", I18n.rev)
                    : (root.pending == "update" ? I18n.tr("maintenance.yes_update", I18n.rev) : I18n.tr("maintenance.yes_repair", I18n.rev));
                primary: true;
                clicked => {
                    if (root.pending == "uninstall") { root.uninstall(); }
                    else if (root.pending == "update") { root.update(); }
                    else { root.repair(); }
                    root.pending = "";
                }
            }
            Btn { text: I18n.tr("ui.cancel", I18n.rev); clicked => { root.pending = ""; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// ── Main window (frameless: OS decorations disabled from Rust) ──
export component MainWindow inherits Window {
    title: "BetterInstaller";
    icon: @image-url("../../../BetterInstaller.png");
    // Sized for the page that needs the most room, not the least: every page that lists
    // things (components, themes, a policy) must open showing whole rows, not cut mid-row.
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 640px;
    background: Pal.bg;
    no-frame: true;

    // Light or dark, set by Rust with the palette. The std widgets (the language and
    // select drop-downs) take their colours from Slint's own Palette, which otherwise
    // follows nothing the installer chose: a light drop-down on the dark sidebar.
    in property <bool> dark: true;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    // 0 welcome (or maintenance) · 1 terms · 2 a setup group · 5 location & components ·
    // 3 progress · 4 done. Which step that is in the flow is Rust's business (`steps`).
    in property <int> page: 0;
    in property <[StepRow]> steps;
    // The Next button reads "Install" on the last step before the install.
    in property <bool> last-step: false;
    in property <string> install-mode: "recommended";
    in property <[string]> recommended-items;
    in property <string> setup-group;
    in property <string> setup-title;
    in property <string> setup-subtitle;
    in property <bool> offer-shortcuts: false;
    in property <bool> shortcut-start: true;
    in property <bool> shortcut-desktop: true;
    in property <bool> offer-autostart: false;
    in property <bool> autostart: false;
    in property <bool> maintenance: false;
    in property <string> maintenance-verb: "Maintenance";
    in property <string> install-location;
    in property <string> installed-version;
    in property <string> new-version;
    in property <bool> update-available: false;
    in property <string> app-name: "Application";
    in property <image> app-logo;
    in property <string> app-version: "1.0.0";
    in property <string> publisher: "";
    in property <bool> signed: false;
    in property <string> signature-status;
    in property <[LaunchRow]> launch-items;
    in-out property <string> install-dir;
    in property <[OptionRow]> options;
    in property <[CompRow]> components;
    in property <string> legal-title;
    in property <[MdBlock]> legal-blocks;
    in property <string> legal-accept-text: "I have read and accept this document.";
    in property <string> legal-counter;
    in property <string> legal-notice;
    in property <bool> legal-require-scroll: false;
    in property <int> legal-index: 0;
    in property <int> legal-count: 0;
    in-out property <bool> legal-accepted: false;
    in property <float> progress: 0;
    in property <string> progress-label;
    in property <bool> can-proceed: true;
    in property <bool> success: true;
    in property <string> result-message;
    in property <string> result-title;
    in property <color> accent: #3b82f6;

    // The one-time picker shown over the Done page (a `swatch` option that asked
    // to be shown again with `show_at_end`). Answering it rewrites the handoff.
    in-out property <bool> final-visible: false;
    in property <[SwatchRow]> final-previews;
    in property <string> final-title: "Pick a look";
    in property <string> final-hint;
    in-out property <string> final-value;
    callback final-picked(string);
    callback final-apply();
    callback final-skip();

    // Native names of the available languages, and which one is showing.
    in property <[string]> language-names;
    in property <int> language-index: 0;
    callback language-picked(int);

    callback go-back();
    callback go-next();
    callback install();
    callback finish();
    callback mode-picked(string);
    callback shortcut-toggled(string, bool);
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    callback option-choice-picked(string, int);
    callback option-card-picked(string, string);
    callback option-expand-toggled(string);
    callback reset-options();
    callback component-toggled(string, bool);
    callback legal-accept-toggled(bool);
    callback open-url(string);
    callback browse-location();
    callback launch-toggled(string, bool);
    callback repair();
    callback update-app();
    callback uninstall-app();
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    VerticalLayout {
        TitleBar {
            title: "BetterInstaller  ·  " + root.app-name;
            start-drag => { root.start-drag(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;          // fill the window below the title bar
            // Sidebar
            Rectangle {
                width: 232px;
                background: Pal.sidebar;
                Rectangle { x: parent.width - 1px; width: 1px; background: Pal.border; }
                VerticalLayout {
                    padding: 22px;
                    padding-top: 24px;
                    spacing: 6px;
                    // Branding header: the app's logo (if provided) + the app name, on a
                    // white rounded plate the way an app icon sits everywhere else (BMM's
                    // mark is a dark glyph on transparency, a smudge on a dark sidebar).
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 34px; height: 34px;
                            background: #ffffff;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Pal.border;
                            Image {
                                source: root.app-logo.width > 0 ? root.app-logo : @image-url("../../../BetterInstaller.png");
                                width: 24px; height: 24px;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.app-name;
                                font-size: 14px; font-weight: 800; color: Pal.ink;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "v" + root.app-version;
                                font-size: 11px; color: Pal.dim;
                            }
                        }
                    }
                    Rectangle { height: 26px; }
                    Stepper {
                        steps: root.steps;
                        page: root.page;
                        install-label: root.maintenance ? root.maintenance-verb : I18n.tr("steps.install", I18n.rev);
                        done-label: I18n.tr("steps.done", I18n.rev);
                    }
                    Rectangle { vertical-stretch: 1; }
                    // The language picker. Offered until the install starts: after that
                    // the Done page is the only one left, and switching there would
                    // translate the buttons but not the result already written.
                    if (root.page <= 2 || root.page == 5) && root.language-names.length > 1 : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: I18n.tr("ui.language", I18n.rev);
                            font-size: 11px; font-weight: 650; color: Pal.dim;
                        }
                        ComboBox {
                            height: 34px;
                            model: root.language-names;
                            current-index: root.language-index;
                            selected => { root.language-picked(self.current-index); }
                        }
                    }
                }
            }
            // Content
            Rectangle {
                background: Pal.bg;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 28px;
                    padding-top: 26px;
                    padding-bottom: 20px;
                    spacing: 16px;
                    Rectangle {
                        vertical-stretch: 1;
                        if root.page == 0 && root.maintenance : MaintenancePage {
                            app-name: root.app-name;
                            location: root.install-location;
                            installed-version: root.installed-version;
                            new-version: root.app-version;
                            update-available: root.update-available;
                            repair => { root.repair(); }
                            update => { root.update-app(); }
                            uninstall => { root.uninstall-app(); }
                        }
                        if root.page == 0 && !root.maintenance : WelcomePage {
                            app-name: root.app-name;
                            app-logo: root.app-logo;
                            signed: root.signed;
                            signature-status: root.signature-status;
                            mode: root.install-mode;
                            recommended-items: root.recommended-items;
                            mode-picked(m) => { root.mode-picked(m); }
                        }
                        if root.page == 5 : LocationPage {
                            components: root.components;
                            install-dir <=> root.install-dir;
                            offer-shortcuts: root.offer-shortcuts;
                            shortcut-start: root.shortcut-start;
                            shortcut-desktop: root.shortcut-desktop;
                            offer-autostart: root.offer-autostart;
                            autostart: root.autostart;
                            component-toggled(id, v) => { root.component-toggled(id, v); }
                            browse => { root.browse-location(); }
                            shortcut-toggled(id, v) => { root.shortcut-toggled(id, v); }
                        }
                        if root.page == 1 : LegalPage {
                            doc-title: root.legal-title;
                            blocks: root.legal-blocks;
                            index: root.legal-index;
                            count: root.legal-count;
                            accept-text: root.legal-accept-text;
                            counter: root.legal-counter;
                            notice: root.legal-notice;
                            require-scroll: root.legal-require-scroll;
                            accepted: root.legal-accepted;
                            accept-toggled(v) => { root.legal-accept-toggled(v); }
                            open-url(u) => { root.open-url(u); }
                        }
                        if root.page == 2 : SetupPage {
                            options: root.options;
                            group: root.setup-group;
                            title: root.setup-title;
                            subtitle: root.setup-subtitle;
                            option-bool-changed(id, v) => { root.option-bool-changed(id, v); }
                            option-select-changed(id, v) => { root.option-select-changed(id, v); }
                            option-choice-picked(id, i) => { root.option-choice-picked(id, i); }
                            option-card-picked(id, v) => { root.option-card-picked(id, v); }
                            option-expand-toggled(id) => { root.option-expand-toggled(id); }
                            reset => { root.reset-options(); }
                        }
                        if root.page == 3 : ProgressPage {
                            progress: root.progress;
                            progress-label: root.progress-label;
                            installing-label: root.maintenance ? root.maintenance-verb + "…" : I18n.tr("progress.installing", I18n.rev);
                        }
                        if root.page == 4 : CompletePage {
                            app-name: root.app-name;
                            success: root.success;
                            result-title: root.result-title;
                            result-message: root.result-message;
                            launch-items: root.launch-items;
                            launch-toggled(id, v) => { root.launch-toggled(id, v); }
                        }
                    }
                    // The button bar, on a hairline.
                    Rectangle { height: 1px; background: Pal.border; }
                    HorizontalLayout {
                        height: 40px;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        if root.page == 1 || root.page == 2 || root.page == 5 : Btn {
                            text: I18n.tr("ui.back", I18n.rev);
                            clicked => { root.go-back(); }
                        }
                        if ((root.page == 0 && !root.maintenance) || root.page == 1 || root.page == 2 || root.page == 5) && !root.last-step : Btn {
                            text: I18n.tr("ui.next", I18n.rev); primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.go-next(); }
                        }
                        if ((root.page == 0 && !root.maintenance) || root.page == 1 || root.page == 2 || root.page == 5) && root.last-step : Btn {
                            text: I18n.tr("ui.install", I18n.rev); primary: true;
                            enabled: root.can-proceed;
                            clicked => { root.install(); }
                        }
                        if root.page == 4 : Btn {
                            text: I18n.tr("ui.finish", I18n.rev); primary: true;
                            clicked => { root.finish(); }
                        }
                    }
                }
            }
        }
    }

    // ── The one-time picker, over everything ──────────────────────────────
    //
    // A sibling of the page layout rather than part of the Done page, so it dims
    // the sidebar and the title bar too: at this point the install is finished
    // and there is exactly one thing left to answer.
    if root.final-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a6;
        // Swallows clicks so nothing behind the overlay stays live.
        TouchArea { width: parent.width; height: parent.height; }

        Rectangle {
            // Three columns plus the padding on each side, so the grid is never the thing
            // that decides the dialog's width.
            width: min(parent.width - 56px, final-grid.content-width + 64px);
            height: min(parent.height - 56px, 640px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Pal.panel;
            border-radius: 14px;
            border-width: 1px;
            border-color: Pal.border;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 28px;
            drop-shadow-color: Pal.shadow;

            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text {
                    text: root.final-title;
                    font-size: 20px; font-weight: 800; color: Pal.ink;
                }
                if root.final-hint != "" : Text {
                    text: root.final-hint;
                    font-size: 12px; color: Pal.dim; wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-height: final-grid.content-height;
                    viewport-width: final-grid.content-width;
                    final-grid := SwatchGrid {
                        cols: 3;
                        width: self.content-width;
                        rows: root.final-previews;
                        value: root.final-value;
                        picked(v) => { root.final-picked(v); }
                    }
                }
                HorizontalLayout {
                    height: 40px;
                    spacing: 12px;
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: I18n.tr("final.skip", I18n.rev);
                        clicked => { root.final-skip(); }
                    }
                    Btn {
                        text: I18n.tr("final.apply", I18n.rev);
                        primary: true;
                        clicked => { root.final-apply(); }
                    }
                }
            }
        }
    }
}
