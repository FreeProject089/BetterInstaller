import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView } from "std-widgets.slint";

// One configurable option presented on the Setup page, mirrored from the
// project's [[setup_option]] declarations in installer.toml.
export struct OptionRow {
    id: string,
    kind: string,        // "select" | "bool" | "license"
    label: string,
    choices: [string],
    bool-value: bool,
    string-value: string,
}

// ── Step indicator ──────────────────────────────────────────────────────
component StepItem inherits HorizontalLayout {
    in property <string> label;
    in property <int> index;
    in property <int> current;
    in property <color> accent;
    spacing: 10px;
    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        y: 4px;
        background: index <= current ? accent : #2a2f3c;
    }
    Text {
        text: label;
        font-size: 13px;
        color: index == current ? white : #6b7280;
        font-weight: index == current ? 700 : 400;
    }
}

// ── Pages ───────────────────────────────────────────────────────────────
component WelcomePage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> app-version;
    in property <string> publisher;
    in property <string> loc-label: "Install location";
    in-out property <string> install-dir;
    spacing: 10px;
    Text { text: "Install " + app-name; font-size: 24px; font-weight: 800; color: white; }
    Text { text: "Version " + app-version + (publisher != "" ? "  ·  " + publisher : ""); font-size: 13px; color: #8b93a7; }
    Rectangle { height: 16px; }
    Text { text: loc-label; font-size: 12px; color: #8b93a7; }
    LineEdit { text <=> install-dir; }
    Rectangle { vertical-stretch: 1; }
}

component SetupPage inherits VerticalLayout {
    in property <[OptionRow]> options;
    in property <color> accent;
    in property <string> title: "Configuration";
    in property <string> hint;
    in property <string> accept-label: "I accept";
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);
    spacing: 8px;
    Text { text: title; font-size: 20px; font-weight: 800; color: white; }
    Text { text: hint; font-size: 12px; color: #8b93a7; wrap: word-wrap; }
    Rectangle { height: 8px; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;
            for opt in options : Rectangle {
                background: #161922;
                border-radius: 8px;
                height: opt.kind == "license" ? 86px : 52px;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: opt.label; font-size: 13px; color: white; vertical-alignment: center; }
                        if opt.kind == "license" : CheckBox {
                            text: accept-label;
                            checked: opt.bool-value;
                            toggled => { option-bool-changed(opt.id, self.checked); }
                        }
                    }
                    if opt.kind == "bool" : CheckBox {
                        checked: opt.bool-value;
                        toggled => { option-bool-changed(opt.id, self.checked); }
                    }
                    if opt.kind == "select" : ComboBox {
                        width: 140px;
                        model: opt.choices;
                        current-value: opt.string-value;
                        selected(v) => { option-select-changed(opt.id, v); }
                    }
                }
            }
        }
    }
}

component ProgressPage inherits VerticalLayout {
    in property <float> progress;
    in property <string> progress-label;
    in property <string> installing-label: "Installing…";
    spacing: 14px;
    Rectangle { vertical-stretch: 1; }
    Text { text: installing-label; font-size: 20px; font-weight: 800; color: white; horizontal-alignment: center; }
    Text { text: progress-label; font-size: 12px; color: #8b93a7; horizontal-alignment: center; }
    ProgressIndicator { progress: progress; height: 8px; }
    Rectangle { vertical-stretch: 1; }
}

component CompletePage inherits VerticalLayout {
    in property <string> app-name;
    in property <bool> success;
    in property <string> result-message;
    spacing: 12px;
    Rectangle { vertical-stretch: 1; }
    Text {
        text: success ? "✓" : "✕";
        font-size: 48px;
        font-weight: 800;
        color: success ? #22c55e : #ef4444;
        horizontal-alignment: center;
    }
    Text {
        text: success ? app-name + " is installed" : "Installation failed";
        font-size: 20px;
        font-weight: 800;
        color: white;
        horizontal-alignment: center;
    }
    Text { text: result-message; font-size: 12px; color: #8b93a7; horizontal-alignment: center; wrap: word-wrap; }
    Rectangle { vertical-stretch: 1; }
}

// ── Main window (defined last: Slint has no forward references) ──────────
export component MainWindow inherits Window {
    title: "BetterInstaller";
    preferred-width: 780px;
    preferred-height: 540px;
    min-width: 680px;
    min-height: 480px;
    background: #0f1117;

    // State driven from Rust
    in property <int> page: 0;            // 0 welcome · 1 setup · 2 progress · 3 done
    in property <string> app-name: "Application";
    in property <string> app-version: "1.0.0";
    in property <string> publisher: "";
    in-out property <string> install-dir;
    in property <[OptionRow]> options;
    in property <float> progress: 0;
    in property <string> progress-label;
    in property <bool> can-proceed: true;
    in property <bool> success: true;
    in property <string> result-message;
    in property <color> accent: #3b82f6;

    // i18n strings (set from Rust; English defaults)
    in property <string> t-next: "Next";
    in property <string> t-back: "Back";
    in property <string> t-install: "Install";
    in property <string> t-finish: "Finish";
    in property <string> t-config-title: "Configuration";
    in property <string> t-config-hint: "These choices are applied on first launch — no setup needed inside the app.";
    in property <string> t-install-loc: "Install location";
    in property <string> t-installing: "Installing…";
    in property <string> t-accept: "I accept";

    // Callbacks to Rust
    callback go-back();
    callback go-next();
    callback install();
    callback finish();
    callback option-bool-changed(string, bool);
    callback option-select-changed(string, string);

    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: #161922;
            VerticalLayout {
                padding: 24px;
                spacing: 6px;
                Text { text: "BetterInstaller"; font-size: 15px; font-weight: 800; color: white; }
                Text { text: root.app-name; font-size: 12px; color: #8b93a7; wrap: word-wrap; }
                Rectangle { height: 18px; }
                VerticalLayout {
                    spacing: 14px;
                    StepItem { label: "Welcome"; index: 0; current: root.page; accent: root.accent; }
                    StepItem { label: "Setup";   index: 1; current: root.page; accent: root.accent; }
                    StepItem { label: "Install"; index: 2; current: root.page; accent: root.accent; }
                    StepItem { label: "Done";    index: 3; current: root.page; accent: root.accent; }
                }
            }
        }

        Rectangle {
            background: #0f1117;
            VerticalLayout {
                padding: 28px;

                Rectangle {
                    vertical-stretch: 1;
                    if root.page == 0 : WelcomePage {
                        app-name: root.app-name;
                        app-version: root.app-version;
                        publisher: root.publisher;
                        loc-label: root.t-install-loc;
                        install-dir <=> root.install-dir;
                    }
                    if root.page == 1 : SetupPage {
                        options: root.options;
                        accent: root.accent;
                        title: root.t-config-title;
                        hint: root.t-config-hint;
                        accept-label: root.t-accept;
                        option-bool-changed(id, v) => { root.option-bool-changed(id, v); }
                        option-select-changed(id, v) => { root.option-select-changed(id, v); }
                    }
                    if root.page == 2 : ProgressPage {
                        progress: root.progress;
                        progress-label: root.progress-label;
                        installing-label: root.t-installing;
                    }
                    if root.page == 3 : CompletePage {
                        app-name: root.app-name;
                        success: root.success;
                        result-message: root.result-message;
                    }
                }

                HorizontalLayout {
                    height: 44px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.page == 1 : Button {
                        text: root.t-back;
                        clicked => { root.go-back(); }
                    }
                    if root.page == 0 : Button {
                        text: root.t-next;
                        primary: true;
                        clicked => { root.go-next(); }
                    }
                    if root.page == 1 : Button {
                        text: root.t-install;
                        primary: true;
                        enabled: root.can-proceed;
                        clicked => { root.install(); }
                    }
                    if root.page == 3 : Button {
                        text: root.t-finish;
                        primary: true;
                        clicked => { root.finish(); }
                    }
                }
            }
        }
    }
}
